---
const year = new Date().getFullYear();

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/amiruan_12' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/amiruddin-zulkifli-9485a2261' },
  { label: 'GitHub', href: 'https://github.com/Amirue' },
  { label: 'Email', href: 'mailto:amiruan12@gmail.com' },
];
---

<footer class="ft">
  <div class="ft__top wrap">
    <div class="ft__logo">AMIRUAN</div>
    <nav class="ft__social" aria-label="Social links">
      {socials.map((s) => (
        <a href={s.href} class="ft__social-link" {s.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {}}>
          {s.label}
        </a>
      ))}
    </nav>
  </div>

  <div class="ft__mid wrap">
    <span class="ft__copy">
      © {year} Amiruan. Built with care.
      <span class="ft__avail"><span class="ft__dot" aria-hidden="true"></span> AVAILABLE FOR HIRE</span>
    </span>
    <a href="/" class="ft__back">← Back to home</a>
  </div>
</footer>

<style>
  /* Transparent: the shared shader lives in ClosingBand.astro. */
  .ft {
    position: relative;
    background: transparent;
    border-top: 1px solid var(--line-d);
    padding: 64px 0 40px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Shader: glow-a.glsl, rendered by Glow.astro */

  .ft > .wrap { position: relative; z-index: 1; }

  .ft__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .ft__logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 4px;
    color: #fff;
  }

  .ft__social {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }

  .ft__social-link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--dim-d);
    transition: color 0.2s ease;
  }
  .ft__social-link:hover { color: #fff; }

  .ft__mid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--dim-d);
  }
  .ft__back:hover { color: #fff; }

  .ft__copy { display: inline-flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .ft__avail {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--green);
  }
  .ft__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
  }

  @media (max-width: 700px) {
    .ft__top,
    .ft__mid { flex-direction: column; align-items: flex-start; gap: 20px; }
  }
</style>

