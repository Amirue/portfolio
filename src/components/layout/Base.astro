---
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';

import '../../styles/tokens.css';
import '../../styles/base.css';

import Header from './Header.astro';
import ClosingBand from './ClosingBand.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  current?: string;
  /** Set false on pages whose design has no CTA above the footer (Work Index, Gallery, 404). */
  cta?: boolean;
  /** 'none' lets a page compose its own ClosingBand (used by Contact, whose hero
      shares one gradient with the marquee bar and footer). */
  band?: 'auto' | 'none';
}

const {
  title,
  description = 'Amiruan — web developer and AI specialist based in Kuala Lumpur. I design, I build, I ship.',
  canonical = Astro.url.pathname,
  ogImage = '/assets/images/hero-1.png',
  ogType = 'website',
  current = '',
  cta = true,
  band = 'auto',
} = Astro.props;

const site = 'https://amiruan.site';
const canonicalURL = new URL(canonical, site).href;
const ogURL = new URL(ogImage, site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammad Amiruddin',
  alternateName: 'Amiruan',
  url: site,
  jobTitle: 'Web Developer & AI Specialist',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kuala Lumpur',
    addressCountry: 'MY',
  },
  sameAs: [
    'https://github.com/Amirue',
    'https://www.linkedin.com/in/amiruddin-zulkifli-9485a2261',
    'https://www.instagram.com/amiruan_12',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A0A0A" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/jpeg" href="https://wp.amiruan.site/wp-content/uploads/2026/10/favicon-amiruan.jpg" />
    <link rel="apple-touch-icon" href="https://wp.amiruan.site/wp-content/uploads/2026/10/favicon-amiruan.jpg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogURL} />
    <meta property="og:site_name" content="Amiruan" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogURL} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    {band === 'auto' && <ClosingBand withCta={cta} />}

    <style is:global>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
      }
      .skip:focus {
        left: 8px;
        top: 8px;
        z-index: 100;
        background: var(--accent);
        color: #fff;
        padding: 10px 16px;
        border-radius: var(--radius);
        font-family: var(--font-mono);
        font-size: 12px;
      }
    </style>

    <script>
      import { initGlow } from '../../scripts/glow.js';

      initGlow();

      // TextLoop: advance one phrase at a time. Removing .is-out and forcing a
      // reflow first makes the incoming phrase jump to its start position below
      // the box while it's still invisible — without the reflow the browser
      // coalesces both class changes and the roll-in is lost.
      document.querySelectorAll('[data-tloop]').forEach((loop) => {
        const items = Array.from(loop.querySelectorAll('.tloop__item'));
        if (items.length < 2) return;
        const gap = Number(loop.getAttribute('data-interval')) || 2600;
        let i = 0;
        setInterval(() => {
          const prev = items[i];
          i = (i + 1) % items.length;
          const next = items[i];
          prev.classList.remove('is-active');
          prev.classList.add('is-out');
          next.classList.remove('is-out');
          void next.offsetWidth;
          next.classList.add('is-active');
        }, gap);
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
