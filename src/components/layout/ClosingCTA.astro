---
import Marquee from './Marquee.astro';

interface Props {
  email?: string;
  ctaHref?: string;
}
const { email = 'amiruan12@gmail.com', ctaHref = '/contact' } = Astro.props;
---

<section class="closing">
  <div class="closing__inner wrap">
    <div class="closing__lines">
      <span class="closing__mask reveal" style="--i:0"><span class="closing__line closing__line--w">I design,</span></span>
      <span class="closing__mask reveal" style="--i:2"><span class="closing__line closing__line--b">I build,</span></span>
      <span class="closing__mask reveal" style="--i:4"><span class="closing__line closing__line--c">I ship.</span></span>
    </div>

    <div class="closing__row">
      <div class="closing__left">
        <span class="closing__kicker">GOT A PROJECT IN MIND?</span>
        <span class="closing__note">Currently open to new work. Usually reply within a day.</span>
      </div>
      <a href={ctaHref} class="closing__cta">SAY HELLO →</a>
    </div>
  </div>

  <Marquee text={`// LET'S TALK · ${email} · OPEN TO WORK ·`} variant="closing" active />
</section>

<style>
  /* Transparent: the shared shader lives in ClosingBand.astro so one gradient
     runs continuously behind the CTA, the marquee bar and the footer. */
  .closing {
    position: relative;
    background: transparent;
  }

  .closing__inner { position: relative; z-index: 1; }

  .closing__inner {
    padding: 90px var(--pad);
    min-height: 802px;          /* ClosingTop is 802 + a 78px marquee = 880 in the design */
    justify-content: center;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .closing__lines {
    display: flex;
    flex-direction: column;
  }

  /* Each line rises out of its own mask, one after another (--i 0/2/4 = 0/160/320ms). */
  .closing__mask {
    display: block;
    overflow: hidden;
    /* Font-size is on the mask so the padding scales with the display face (the line
       inherits it). 0.1em clears the 'g'/'p' descenders; the negative margin removes
       the same amount again so the design's tight 0.94em line spacing is unchanged. */
    font-size: clamp(44px, 8.6vw, 124px);
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  /* The mask itself must not move — only the line inside it rises. */
  .closing__mask.reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .closing__line {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(44px, 8.6vw, 124px);
    line-height: 0.94;
    letter-spacing: -0.04em;
    transform: translateY(115%);
    transition: transform 0.85s cubic-bezier(0.22, 0.9, 0.24, 1);
    transition-delay: calc(var(--i, 0) * 80ms);
  }
  .closing__mask.is-in .closing__line { transform: translateY(0); }
  .closing__line--w { color: #fff; }
  .closing__line--b { color: var(--accent-blue); }
  .closing__line--c { color: var(--accent); }

  .closing__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .closing__left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .closing__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--accent-blue);
  }

  .closing__note {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--dim-d);
  }

  .closing__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 32px;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 1.5px;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .closing__cta:hover {
    transform: translateY(-2px);
    background: #ff564b;
  }
</style>
