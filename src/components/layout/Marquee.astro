---
interface Props {
  text: string;
  variant?: 'top' | 'closing';
  active?: boolean;
}
const { text, variant = 'top', active = false } = Astro.props;

// Duplicate enough for a seamless loop
const items = Array.from({ length: 6 });
---

<div class={`mq mq--${variant}`} aria-hidden="true">
  <div class="mq__track marquee__track">
    {items.map((_, i) => (
      <span class={`mq__item ${active && i % 2 === 0 ? 'is-bright' : ''}`}>{text}</span>
    ))}
  </div>
</div>

<style>
  .mq {
    border-bottom: 1px solid var(--line-d);
    background: var(--marquee);
    overflow: hidden;
    user-select: none;
  }

  .mq--top {
    height: 36px;
    display: flex;
    align-items: center;
  }

  /* Layout comes from .marquee__track in base.css — this only sets the pace.
     Don't redeclare @keyframes marquee here: keyframe names aren't scoped, so a
     second definition would silently override base.css for every marquee on the site. */
  .mq__track {
    animation-duration: 60s;
  }

  .mq:hover .mq__track {
    animation-play-state: paused;
  }

  .mq__item {
    white-space: nowrap;
    letter-spacing: 1px;
  }

  .mq--top .mq__item {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--orange);
  }

  /* Black bar between the CTA and the footer, over the shared gradient.
     Opaque #0A0A0A with a #2A2A33 top rule, content inset by --pad (design: pad [0,64]). */
  .mq--closing {
    border-top: 1px solid var(--line-d2);
    border-bottom: none;
    background: var(--ink);
    height: 78px;
    padding: 0 var(--pad);
    display: flex;
    align-items: center;
  }

  .mq--closing .mq__item {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: rgba(255, 255, 255, 0.2);
  }

  .mq--closing .mq__item.is-bright {
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .mq__track { animation: none; }
  }
</style>
