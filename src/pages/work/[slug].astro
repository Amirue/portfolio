---
import Base from '../../components/layout/Base.astro';
import Glow from '../../components/layout/Glow.astro';
import { fetchWorksData, fetchWorkBySlug, fetchWorkTypes, workTypeLabel } from '../../lib/wordpress';

export async function getStaticPaths() {
  const works = await fetchWorksData();
  return works.map((w) => ({ params: { slug: w.slug } }));
}

const { slug } = Astro.params;
const work = await fetchWorkBySlug(slug ?? '');
const workTypes = await fetchWorkTypes();

if (!work) {
  return Astro.redirect('/work');
}

const typeLabel = (t: string) => workTypeLabel(t, workTypes);

// Strip tags from the rendered post body for the "result" paragraph.
const strip = (html: string) =>
  html
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const result = strip(work.content || '');
const images = work.images.length ? work.images : work.image ? [work.image] : [];

const metaRows = [
  { k: 'ROLE', v: work.role },
  { k: 'YEAR', v: work.year },
  { k: 'TYPE', v: work.types.map((t) => typeLabel(t)).join(' · ') },
].filter((r) => r.v);
---

<Base
  title={`${work.title} — Amiruan`}
  description={work.subtitle || `${work.title} — a case study by Amiruan.`}
  current="work"
  cta={false}
>
  <section class="case">
    <!-- Info -->
    <div class="case__info">
      <a class="case__back" href="/work">←&nbsp;&nbsp;BACK TO WORK</a>
      <h1 class="case__title">{work.title}</h1>
      {work.subtitle && <p class="case__sub">{work.subtitle}</p>}

      {work.context && (
        <div class="case__block">
          <span class="case__lbl">THE CONTEXT</span>
          <p class="case__txt">{work.context}</p>
        </div>
      )}

      {work.process && (
        <div class="case__block">
          <span class="case__lbl">THE PROCESS</span>
          <p class="case__txt">{work.process}</p>
        </div>
      )}

      {work.tools.length > 0 && (
        <div class="case__block">
          <span class="case__lbl">TOOLS</span>
          <ul class="case__tools">
            {work.tools.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      )}

      {work.metric && <span class="case__metric">✓&nbsp;&nbsp;{work.metric}</span>}
      {result && (
        <div class="case__block">
          <span class="case__lbl">THE RESULT</span>
          <p class="case__txt">{result}</p>
        </div>
      )}

      {work.demoUrl && (
        <a class="case__demo" href={work.demoUrl} target="_blank" rel="noopener">VIEW LIVE →</a>
      )}
    </div>

    <!-- Visual -->
    <div class="case__visual" data-gallery>
      <Glow variant="dark" />

      {images.length > 0 ? (
        <>
          <div class="case__stage">
            {images.map((src, i) => (
              <img
                class={`case__img ${i === 0 ? 'is-active' : ''}`}
                src={src}
                alt={`${work.title} — capture ${i + 1}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                data-slide={i}
              />
            ))}
          </div>

          <div class="case__hud">
            <span class="case__count" data-count>{`1 / ${images.length}`}</span>
            {images.length > 1 && (
              <span class="case__nav">
                <button class="case__arrow" data-prev aria-label="Previous image">‹</button>
                <button class="case__arrow" data-next aria-label="Next image">›</button>
              </span>
            )}
          </div>

          {/* Thumbnails. The arrows and the counter alone didn't make it obvious there
              were six images — this shows the whole set at a glance and jumps directly. */}
          {images.length > 1 && (
            <div class="case__thumbs" data-thumbs>
              {images.map((src, i) => (
                <button
                  class={`case__thumb ${i === 0 ? 'is-active' : ''}`}
                  data-thumb={i}
                  aria-label={`Show image ${i + 1} of ${images.length}`}
                >
                  <img src={src} alt="" loading="lazy" />
                </button>
              ))}
            </div>
          )}

          <div class="case__cap">
            <span class="case__st">CAPTURE</span>
            <span class="case__capTxt" data-cap>{`CAPTURE 1 OF ${images.length}`}</span>
          </div>
        </>
      ) : (
        <div class="case__stage case__stage--empty">
          <span class="case__nophoto">NO CAPTURES</span>
        </div>
      )}
    </div>
  </section>

  <!-- Meta -->
  {metaRows.length > 0 && (
    <section class="cmeta">
      <div class="wrap cmeta__row">
        {metaRows.map((r) => (
          <div class="cmeta__item">
            <span class="cmeta__k">{r.k}</span>
            <span class="cmeta__v">{r.v}</span>
          </div>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .case {
    display: grid;
    grid-template-columns: 560px 1fr;
    min-height: 900px;
    background: var(--ink);
  }

  /* ── Info column ── */
  .case__info {
    padding: 80px 64px;
    display: flex;
    flex-direction: column;
    gap: 34px;
    align-items: flex-start;
  }
  .case__back { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--accent); }
  .case__meta { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--accent-blue); }
  .case__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 42px;
    line-height: 1.08;
    letter-spacing: -1.5px;
    color: #fff;
  }
  .case__sub { font-family: var(--font-body); font-size: 17px; line-height: 1.5; color: #8a8a9a; }

  .case__block { display: flex; flex-direction: column; gap: 10px; }
  .case__lbl { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; color: var(--accent-blue); }
  .case__txt { font-family: var(--font-body); font-size: 15px; line-height: 1.65; color: #a8a8b3; }

  .case__tools { display: flex; flex-wrap: wrap; gap: 8px; }
  .case__tools li {
    padding: 6px 12px;
    border: 1px solid var(--line-d2);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.5px;
    color: #fff;
  }

  .case__metric { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.5px; color: var(--accent); }
  .case__demo {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    color: #fff;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 4px;
  }

  /* ── Visual column ── */
  .case__visual {
    position: relative;
    overflow: hidden;
    padding: 56px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--ink);
  }
  .case__visual > :not(:global(.glow)) { position: relative; z-index: 1; }

  .case__stage {
    flex: 1;
    position: relative;
    border: 1px solid var(--line-d2);
    border-radius: var(--radius);
    background: #0d0d12;
    overflow: hidden;
    min-height: 420px;
  }
  .case__stage--empty { display: flex; align-items: center; justify-content: center; }
  .case__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .case__img.is-active { opacity: 1; }
  .case__nophoto { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1.5px; color: var(--dim-d); }

  .case__hud { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .case__count { font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; color: #fff; }

  /* Thumbnail strip — makes the size of the gallery visible at a glance. */
  .case__thumbs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }
  .case__thumbs::-webkit-scrollbar { display: none; }
  .case__thumb {
    flex: 0 0 auto;
    width: 64px;
    height: 46px;
    padding: 0;
    border: 1px solid var(--line-d2);
    border-radius: var(--radius);
    overflow: hidden;
    opacity: 0.5;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }
  .case__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .case__thumb:hover { opacity: 0.8; }
  .case__thumb.is-active { opacity: 1; border-color: var(--accent); }
  .case__nav { display: flex; gap: 8px; }
  .case__arrow {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-d2);
    border-radius: var(--radius);
    font-size: 20px;
    line-height: 1;
    color: #fff;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .case__arrow:hover { border-color: var(--accent); color: var(--accent); }

  .case__cap { display: flex; flex-direction: column; gap: 6px; }
  .case__st { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: #fff; }
  .case__capTxt { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--accent-blue); }

  /* ── Meta strip ── */
  .cmeta { background: var(--ink); padding: 32px 0; border-top: 1px solid var(--line-d2); }
  .cmeta__row { display: flex; gap: 32px; flex-wrap: wrap; }
  .cmeta__item { display: flex; flex-direction: column; gap: 6px; }
  .cmeta__k { font-family: var(--font-mono); font-size: 9px; letter-spacing: 1.5px; color: var(--accent-blue); }
  .cmeta__v { font-family: var(--font-body); font-size: 14px; color: #fff; }

  @media (max-width: 1100px) {
    .case { grid-template-columns: 1fr; min-height: 0; }
    .case__info { padding: 56px var(--pad); gap: 26px; }
    .case__title { font-size: 32px; letter-spacing: -1px; }
    .case__visual { padding: 32px var(--pad); min-height: 0; }
    .case__stage { min-height: 300px; }
    .cmeta { padding: 24px 0; }
    .cmeta__row { gap: 20px; }
  }
</style>

<script>
  // Simple capture carousel for the case-study visual.
  const root = document.querySelector('[data-gallery]');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const thumbs = Array.from(root.querySelectorAll<HTMLElement>('[data-thumb]'));
    if (slides.length > 1) {
      const count = root.querySelector('[data-count]');
      const cap = root.querySelector('[data-cap]');
      let i = 0;
      const show = (n: number) => {
        i = (n + slides.length) % slides.length;
        slides.forEach((s, idx) => s.classList.toggle('is-active', idx === i));
        thumbs.forEach((t, idx) => t.classList.toggle('is-active', idx === i));
        if (count) count.textContent = `${i + 1} / ${slides.length}`;
        if (cap) cap.textContent = `CAPTURE ${i + 1} OF ${slides.length}`;
      };
      root.querySelector('[data-prev]')?.addEventListener('click', () => show(i - 1));
      root.querySelector('[data-next]')?.addEventListener('click', () => show(i + 1));
      thumbs.forEach((t) => {
        t.addEventListener('click', () => show(Number(t.getAttribute('data-thumb')) || 0));
      });
    }
  }
</script>
