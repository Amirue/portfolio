---
import { fetchGalleryData } from '../lib/wordpress';

const galleryData = await fetchGalleryData();
---<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Amiruan - Gallery. Photos from events, travels, and the everyday stuff.">
  <meta name="theme-color" content="#FFFFFF">
  <title>Gallery - Amiruan</title>
  <link rel="stylesheet" href="/assets/css/styles.css">
  <link rel="stylesheet" href="/assets/css/gallery.css">
</head>
<body class="gallery-page">

  <!-- Header / Navigation -->
  <header class="header" id="header" data-ux-law="Jakob's Law" data-ux-desc="The same navigation labels as the home page (About, Work, Stack, Experience, Gallery, Contact) so cross-page travel feels familiar.">
    <div class="container header__inner">
      <a href="/" class="brand" aria-label="Amiruan home">
        Amiruan<span class="brand__dot" aria-hidden="true"></span>
      </a>

      <nav class="nav" aria-label="Primary navigation">
        <a href="/#about" class="nav__link">About</a>
        <a href="/#projects" class="nav__link">Work</a>
        <a href="/#stack" class="nav__link">Stack</a>
        <a href="/#experience" class="nav__link">Experience</a>
        <a href="/gallery" class="nav__link active" aria-current="page">Gallery</a>
        <a href="/#contact" class="nav__link">Contact</a>
      </nav>

      <div class="header__actions">
        <button class="header__tool ux-pathfinder__toggle" id="uxPathfinderToggle" aria-label="Open UX Pathfinder" aria-expanded="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <span>UX Pathfinder</span>
        </button>
        <button class="header__tool header__tool--coral" id="aiToggle" aria-label="Open AI command terminal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          <span>Ask AI</span>
          <kbd>âŒ˜K</kbd>
        </button>
        <button class="mobile-toggle" id="mobileToggle" aria-label="Open menu" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <a href="/#about" class="nav__link">About</a>
    <a href="/#projects" class="nav__link">Work</a>
    <a href="/#stack" class="nav__link">Stack</a>
    <a href="/#experience" class="nav__link">Experience</a>
    <a href="/gallery" class="nav__link active" aria-current="page">Gallery</a>
    <a href="/#contact" class="nav__link">Contact</a>
  </div>

  <main>
    <!-- Gallery Hero -->
    <section class="g-hero" id="gallery" data-ux-law="Aesthetic-Usability Effect" data-ux-desc="A calm, editorial opening with a monospace section label and spacious type creates an immediate sense of craft before any image loads.">
      <div class="container g-hero__inner reveal">
        <div class="g-hero__marquee" aria-hidden="true">
          <span>Gallery</span>
          <span>Gallery</span>
          <span>Gallery</span>
          <span>Gallery</span>
          <span>Gallery</span>
        </div>
<div class="g-hero__row">
          <div>
            <h1 class="g-hero__title">Life outside of work</h1>
            <p class="g-hero__sub">Things I have been up to outside of work. Events, trips, and random moments.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Profile + Stories + Feed -->
    <section class="section container" style="padding-top: 4.5rem;">
      <div class="g-filterbar reveal" id="gStories" role="tablist" aria-label="Filter gallery by type"></div>

      <div class="g-feed-reveal reveal">
        <div class="g-feed" id="gFeed" aria-live="polite"></div>
        <button class="g-load-more" id="gLoadMore" type="button" hidden>
          Load earlier posts
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
        </button>
        <p class="g-end-note" id="gEndNote">â€” You've seen it all. Back to the future. â€”</p>
      </div>
    </section>
  </main>

  <footer class="footer" id="footer">
    <div class="container">
      <div class="footer__top">
        <div class="footer__brand">
          <a href="/" class="footer__logo">Amiruan<span class="footer__dot" aria-hidden="true"></span></a>
          <p>Creative Web Developer & AI Specialist</p>
          <div class="footer__social">
            <a href="#" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            </a>
            <a href="#" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>

        <div class="footer__status">
          <div class="footer__status-item">
            <span class="footer__status-dot" aria-hidden="true"></span>
            <span>System: <strong>Operational</strong></span>
          </div>
          <div class="footer__status-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Status: <strong id="availabilityStatus">Available for hire</strong></span>
          </div>
        </div>
      </div>

      <div class="footer__bottom">
        <p>&copy; <span id="year"></span> Amiruan. Built with precision.</p>
        <p><a href="/" class="footer__back">â† Back to home</a></p>
      </div>
    </div>
  </footer>

  <!-- AI Terminal Modal -->
  <div class="terminal-overlay" id="terminalOverlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="AI command terminal" data-ux-law="Doherty Threshold" data-ux-desc="The terminal responds instantly to keyboard input, keeping the interaction pace below 400ms and maintaining user momentum.">
    <div class="terminal-modal">
      <div class="terminal-modal__header">
        <div class="terminal-modal__title">
          <span>&gt;_</span>
          amiruan-terminal â€” ask me anything
        </div>
        <button class="terminal-modal__close" id="terminalClose" aria-label="Close terminal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="terminal-modal__body" id="terminalBody">
        <div class="terminal-log" id="terminalLog">
          <div class="terminal-log__entry terminal-log__entry--system">Welcome to the Amiruan terminal.</div>
          <div class="terminal-log__entry terminal-log__entry--system">Try: â€œstacksâ€, â€œprojectsâ€, â€œgalleryâ€, or â€œavailabilityâ€</div>
        </div>
      </div>
      <div class="terminal-modal__hint">
        <span>Press <strong>Enter</strong> to submit</span>
        <span>Press <strong>Esc</strong> or <strong>âŒ˜K</strong> to close</span>
      </div>
      <div class="terminal-modal__input-wrap">
        <span class="hero__terminal-prompt">&gt;</span>
        <input type="text" class="terminal-modal__input" id="terminalInput" placeholder='ask_amiruan("...")' autocomplete="off" aria-label="Terminal input">
      </div>
    </div>
  </div>

  <!-- UX Pathfinder Panel -->
  <div class="ux-pathfinder-backdrop" id="uxPathfinderBackdrop" aria-hidden="true"></div>
  <aside class="ux-pathfinder-panel" id="uxPathfinderPanel" aria-label="UX Pathfinder panel" aria-hidden="true">
    <div class="ux-pathfinder-panel__header">
      <div class="ux-pathfinder-panel__title">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
        UX Pathfinder
      </div>
      <button class="ux-pathfinder-panel__close" id="uxPathfinderClose" aria-label="Close UX Pathfinder">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="ux-pathfinder-panel__body">
      <p class="ux-pathfinder-panel__intro">
        This portfolio is built on proven UX laws from <a href="https://lawsofux.com/" target="_blank" rel="noopener noreferrer" style="color: var(--accent-lavender); text-decoration: underline;">lawsofux.com</a>.<br><br>
        <strong>Click any law</strong> below to close this panel and jump to where it's applied on the page. Close anytime with the X, the backdrop, or the Esc key.
      </p>
      <div id="uxPathfinderList"></div>
    </div>
  </aside>

  <!-- Gallery Lightbox -->
  <div class="g-lightbox" id="gLightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <div class="g-lightbox__stage">
      <button class="g-lightbox__close" id="gLbClose" aria-label="Close photo viewer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <button class="g-lightbox__nav g-lightbox__nav--prev" id="gLbPrev" type="button" aria-label="Previous photo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="g-lightbox__nav g-lightbox__nav--next" id="gLbNext" type="button" aria-label="Next photo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>
      <figure class="g-lightbox__frame">
        <img id="gLbImg" src="" alt="">
        <figcaption class="g-lightbox__counter" id="gLbCounter"></figcaption>
      </figure>
    </div>
    <aside class="g-lightbox__side" id="gLbSide"></aside>
  </div>

<script is:inline src="/assets/js/main.js"></script>
<script is:inline define:vars={{ galleryData }}>
  window.galleryData = galleryData;
</script>
<script is:inline src="/assets/js/gallery.js"></script>
</body>
</html>


