---
import Base from '../components/layout/Base.astro';
import Glow from '../components/layout/Glow.astro';
import { fetchGalleryData } from '../lib/wordpress';

const { posts, highlights } = await fetchGalleryData();

// Emoji per filter, straight from the design (◌ ALL, 🎤 EVENTS, ✈️ TRAVEL, 🖥️ STUDIO, 🌙 MOMENTS)
const ICONS: Record<string, string> = {
  all: '◌',
  events: '🎤',
  travel: '✈️',
  studio: '🖥️',
  moments: '🌙',
};

const FILTERS = highlights.map((h) => ({ ...h, icon: ICONS[h.id] ?? '◌' }));

const INITIAL = 6;
const pad = (n: number) => String(n).padStart(2, '0');
const years = [...new Set(posts.map((p) => (p.date || '').match(/\d{4}/)?.[0]).filter(Boolean))];
const feedMeta = `${pad(posts.length)} POSTS${years.length ? `  ·  ${years.join(' / ')}` : ''}`;
---

<Base
  title="Gallery — Amiruan"
  description="Life outside of work — WordCamp, studio sessions, trips and random moments. Photos from Kuala Lumpur and beyond."
  current="gallery"
  cta={false}
>
  <!-- Hero -->
  <section class="ghero">
    <Glow variant="a" />
    <div class="wrap ghero__top">
      <h1 class="ghero__title">Gallery</h1>
    </div>

    <div class="ghero__band" aria-hidden="true">
      <div class="marquee ghero__row">
        <div class="marquee__track ghero__track ghero__track--l">
          {[0, 1, 2, 3, 4, 5, 6, 7].map(() => <span>// LIFE LATELY</span>)}
        </div>
      </div>
      <div class="marquee ghero__row">
        <div class="marquee__track ghero__track ghero__track--r">
          {[0, 1, 2, 3, 4, 5, 6, 7].map(() => <span class="ghero__outline">MOMENTS · EVENTS · TRAVEL · STUDIO</span>)}
        </div>
      </div>
    </div>

    <div class="wrap ghero__foot">
      <span class="ghero__meta">{feedMeta}</span>
      <span class="ghero__scroll">SCROLL ↓</span>
    </div>
  </section>

  <!-- Filter -->
  <section class="gfilter">
    <div class="wrap gfilter__inner" role="tablist" aria-label="Filter gallery">
      {FILTERS.map((f, i) => (
        <button
          class={`gfilter__item ${i === 0 ? 'is-active' : ''}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-gfilter={f.id}
        >
          <span class="gfilter__ring" aria-hidden="true">{f.icon}</span>
          <span class="gfilter__lbl">{f.label.toUpperCase()}</span>
        </button>
      ))}
    </div>
  </section>

  <!-- Feed -->
  <section class="gfeed">
    <div class="wrap">
      <header class="gfeed__head">
        <h2 class="gfeed__h">Latest posts</h2>
        <span class="gfeed__meta" data-gcount>{feedMeta}</span>
      </header>

      {posts.length > 0 ? (
        <>
          <div class="ggrid" data-ggrid>
            {posts.map((p, i) => (
              <article class="post" data-gtype={p.type} data-gindex={i} data-media={p.media.join('|')}>
                <div class="post__bar">
                  <span class="post__type">{p.type.toUpperCase()}</span>
                  <span class="post__meta">{`${pad(i + 1)}   ·   ${p.date || '—'}`}</span>
                </div>
                <span class="post__rule" aria-hidden="true"></span>
                <div class="post__media">
                  {p.media[0] ? (
                    <button
                      type="button"
                      class="post__open"
                      data-open={i}
                      aria-label={`View ${p.title} — ${p.media.length} photo${p.media.length === 1 ? '' : 's'}`}
                    >
                      <img src={p.media[0]} alt={p.title} loading={i < 3 ? 'eager' : 'lazy'} />
                      {p.media.length > 1 && (
                        <span class="post__count">{`${pad(p.media.length)} PHOTOS`}</span>
                      )}
                    </button>
                  ) : (
                    <span class="post__nophoto" aria-hidden="true">NO PHOTO</span>
                  )}
                </div>
                <span class="post__rule" aria-hidden="true"></span>
                <div class="post__foot">
                  <h3 class="post__t">{p.title}</h3>
                  {p.location && <span class="post__loc">{p.location.toUpperCase()}</span>}
                  {p.tags[0] && <span class="post__tag">{p.tags[0]}</span>}
                </div>
              </article>
            ))}
          </div>

          {/* Lightbox. Steps through every image of the post that was opened. Uses an
              .is-open class rather than the hidden attribute — an author `display` rule
              outranks the UA stylesheet's [hidden] { display: none }. */}
          <div class="lbox" data-lbox role="dialog" aria-modal="true" aria-label="Photo viewer">
            <button class="lbox__close" data-lbox-close aria-label="Close viewer">✕</button>
            <button class="lbox__nav lbox__nav--prev" data-lbox-prev aria-label="Previous photo">‹</button>
            <img class="lbox__img" data-lbox-img src="" alt="" />
            <button class="lbox__nav lbox__nav--next" data-lbox-next aria-label="Next photo">›</button>
            <span class="lbox__count" data-lbox-count></span>
          </div>

          <div class="gend">
            <button class="gend__more" data-gmore hidden>LOAD EARLIER POSTS</button>
            <span class="gend__note">— You&rsquo;ve seen it all. Back to the future. —</span>
          </div>
        </>
      ) : (
        <p class="gempty">
          No gallery posts came back from WordPress. Check <code>PUBLIC_WP_API_URL</code>.
        </p>
      )}
    </div>
  </section>
</Base>

<style>
  /* ── Hero: 620px, shader, title + 2 marquee rows + meta ── */
  .ghero { position: relative; height: 620px; overflow: hidden; background: var(--ink); }
  .ghero > .wrap { position: relative; z-index: 1; }

  .ghero__top { position: absolute; left: 0; right: 0; top: 90px; }
  .ghero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 88px;
    line-height: 1.05;
    letter-spacing: -3px;
    color: #fff;
  }

  .ghero__band { position: absolute; left: 0; right: 0; top: 273px; }
  .ghero__row { height: 78px; overflow: hidden; }
  .ghero__track { align-items: center; height: 100%; }
  .ghero__track span {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 52px;
    letter-spacing: -2px;
    color: #fff;
    white-space: nowrap;
  }
  /* Design: faint solid blue, not an outline — #4DB8FF38 (22%). */
  .ghero__outline { color: rgba(77, 184, 255, 0.22) !important; }
  .ghero__track--l { animation: marquee 58s linear infinite; }
  .ghero__track--r { animation: marqueeR 58s linear infinite; }

  .ghero__foot {
    position: absolute;
    left: 0;
    right: 0;
    top: 509px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .ghero__meta { color: var(--accent-blue); letter-spacing: 1.5px; }
  .ghero__scroll { color: var(--dim-d); font-size: 10px; letter-spacing: 2px; }

  /* ── Filter: circular rings, icon over label ── */
  .gfilter { background: var(--ink); border-top: 1px solid var(--line-d2); padding: 44px 0; }
  .gfilter__inner { display: flex; gap: 32px; flex-wrap: wrap; }
  .gfilter__item { display: flex; flex-direction: column; align-items: center; gap: 9px; }
  .gfilter__ring {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--line-d2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    line-height: 1;
    transition: border-color 0.2s ease;
  }
  .gfilter__lbl {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--dim-d);
    transition: color 0.2s ease;
  }
  .gfilter__item:hover .gfilter__ring { border-color: var(--accent-blue); }
  .gfilter__item:hover .gfilter__lbl { color: #fff; }
  .gfilter__item.is-active .gfilter__ring { border-color: var(--accent); }
  .gfilter__item.is-active .gfilter__lbl { color: var(--ink); }

  /* ── Feed ── */
  .gfeed { background: var(--paper); color: var(--ink); padding: 48px 0 120px; }
  .gfeed__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .gfeed__h {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
    letter-spacing: -1.2px;
    color: var(--ink);
  }
  .gfeed__meta { font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; color: var(--accent-blue); }

  .ggrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }

  .post {
    display: flex;
    flex-direction: column;
    background: var(--tile);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .post[hidden] { display: none; }

  .post__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 16px;
    min-height: 39px;
  }
  .post__type { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: #8a8a9a; }
  .post__meta { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--accent-blue); }
  .post__rule { height: 1px; background: var(--line-d2); }

  .post__media { height: 420px; background: #0d0d12; }
  .post__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post__nophoto {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    color: var(--dim-d);
  }

  /* The card shows one image; the rest live in the lightbox. */
  .post__open { display: block; width: 100%; height: 100%; padding: 0; position: relative; cursor: zoom-in; }
  .post__open img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post__count {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 5px 9px;
    background: rgba(10, 10, 10, 0.72);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 1.5px;
    color: #fff;
  }

  /* ── Lightbox ── */
  .lbox {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(6, 6, 8, 0.94);
  }
  .lbox.is-open { display: flex; }
  .lbox__img {
    max-width: min(1200px, 88vw);
    max-height: 82vh;
    object-fit: contain;
    border-radius: var(--radius);
  }
  .lbox__close,
  .lbox__nav {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .lbox__close:hover,
  .lbox__nav:hover { border-color: var(--accent); color: var(--accent); }
  .lbox__close { top: 24px; right: 24px; width: 44px; height: 44px; font-size: 16px; }
  .lbox__nav { top: 50%; transform: translateY(-50%); width: 52px; height: 52px; font-size: 28px; line-height: 1; }
  .lbox__nav--prev { left: 24px; }
  .lbox__nav--next { right: 24px; }
  .lbox__count {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.7);
  }
  .lbox__nav[disabled] { opacity: 0.3; cursor: default; }

  @media (max-width: 760px) {
    .lbox__nav { width: 42px; height: 42px; font-size: 22px; }
    .lbox__nav--prev { left: 10px; }
    .lbox__nav--next { right: 10px; }
    .lbox__close { top: 12px; right: 12px; }
  }

  .post__foot { padding: 16px; display: flex; flex-direction: column; gap: 8px; min-height: 94px; }
  .post__t { font-family: var(--font-display); font-weight: 500; font-size: 16px; color: #fff; }
  .post__loc { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: #7a7a88; }
  .post__tag { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.5px; color: #4d9fff; }

  /* ── End ── */
  .gend { display: flex; flex-direction: column; align-items: center; gap: 28px; padding-top: 120px; }
  .gend__more {
    padding: 14px 32px;
    border: 1px solid var(--line-l);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--ink);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .gend__more:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  .gend__note { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1px; color: var(--accent-blue); }

  .gempty { font-family: var(--font-mono); font-size: 12px; color: var(--dim-l); }

  @media (max-width: 1100px) {
    .ghero { height: auto; padding: 48px 0 40px; display: flex; flex-direction: column; gap: 28px; }
    /* See work/index.astro — `.ghero > .wrap` wins on specificity, so `top: auto`
       is what actually cancels the desktop absolute offsets. */
    .ghero__top, .ghero__band, .ghero__foot { position: static; top: auto; }
    .ghero__title { font-size: 56px; letter-spacing: -2px; }
    .ghero__row { height: 48px; }
    .ghero__track span { font-size: 30px; letter-spacing: -1px; }
    .gfilter { padding: 32px 0; }
    .gfilter__inner { gap: 20px; }
    .gfilter__ring { width: 52px; height: 52px; font-size: 18px; }
    .gfeed { padding: 40px 0 80px; }
    .ggrid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .post__media { height: 300px; }
    .gend { padding-top: 72px; }
  }

  @media (max-width: 620px) {
    .ggrid { grid-template-columns: 1fr; }
    .post__media { height: 260px; }
  }
</style>

<script>
  // ── Lightbox ──────────────────────────────────────────────────────────────
  // Cards show one image; the rest are reachable here. Media lists ride on the card's
  // `data-media` (pipe-separated) so the viewer needs no extra fetch.
  const lbox = document.querySelector<HTMLElement>('[data-lbox]');
  const lboxImg = document.querySelector<HTMLImageElement>('[data-lbox-img]');
  const lboxCount = document.querySelector<HTMLElement>('[data-lbox-count]');
  const lboxPrev = document.querySelector<HTMLButtonElement>('[data-lbox-prev]');
  const lboxNext = document.querySelector<HTMLButtonElement>('[data-lbox-next]');

  if (lbox && lboxImg) {
    let list: string[] = [];
    let at = 0;
    let lastFocus: HTMLElement | null = null;

    const show = (n: number) => {
      if (!list.length) return;
      at = (n + list.length) % list.length;
      lboxImg.src = list[at];
      lboxImg.alt = `${at + 1} of ${list.length}`;
      if (lboxCount) lboxCount.textContent = `${String(at + 1).padStart(2, '0')} / ${String(list.length).padStart(2, '0')}`;
      const single = list.length < 2;
      if (lboxPrev) lboxPrev.disabled = single;
      if (lboxNext) lboxNext.disabled = single;
    };

    const open = (media: string[], trigger: HTMLElement) => {
      list = media;
      lastFocus = trigger;
      lbox.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      show(0);
      lboxNext?.focus();
    };

    const close = () => {
      lbox.classList.remove('is-open');
      document.body.style.overflow = '';
      lboxImg.src = '';
      lastFocus?.focus();
    };

    document.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('[data-media]');
        const media = (card?.getAttribute('data-media') || '').split('|').filter(Boolean);
        if (media.length) open(media, btn);
      });
    });

    lboxPrev?.addEventListener('click', () => show(at - 1));
    lboxNext?.addEventListener('click', () => show(at + 1));
    document.querySelector('[data-lbox-close]')?.addEventListener('click', close);
    lbox.addEventListener('click', (e) => { if (e.target === lbox) close(); });
    document.addEventListener('keydown', (e) => {
      if (!lbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(at - 1);
      else if (e.key === 'ArrowRight') show(at + 1);
    });
  }

  const grid = document.querySelector('[data-ggrid]');
  if (grid) {
    const INITIAL = 6;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-gtype]'));
    const moreBtn = document.querySelector<HTMLButtonElement>('[data-gmore]');
    const countEl = document.querySelector('[data-gcount]');
    const row = document.querySelector('[role="tablist"][aria-label="Filter gallery"]');

    let filter = 'all';
    let expanded = cards.length <= INITIAL;

    // Hide everything past the initial batch until "load earlier" is pressed.
    const render = () => {
      let shown = 0;
      let matching = 0;
      for (const card of cards) {
        const typeOk = filter === 'all' || card.dataset.gtype === filter;
        if (typeOk) matching++;
        // Keep the design's ordering: first N of the *matching* set.
        const withinBatch = typeOk && (expanded || matching <= INITIAL);
        card.hidden = !withinBatch;
        if (withinBatch) shown++;
      }
      if (moreBtn) moreBtn.hidden = expanded || shown >= matching;
      if (countEl) {
        countEl.textContent = `${String(matching).padStart(2, '0')} POST${matching === 1 ? '' : 'S'}`;
      }
    };

    moreBtn?.addEventListener('click', () => {
      expanded = true;
      render();
    });

    row?.querySelectorAll<HTMLButtonElement>('[data-gfilter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        filter = btn.dataset.gfilter || 'all';
        expanded = false;
        row.querySelectorAll('[data-gfilter]').forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        render();
      });
    });

    render();
  }
</script>
