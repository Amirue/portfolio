---
import Base from '../components/layout/Base.astro';
import ClosingCTA from '../components/layout/ClosingCTA.astro';
import { fetchWorksData } from '../lib/wordpress';

const works = await fetchWorksData();
const featured = works.slice(0, 3);

// ── Static copy (declared here so a CPT swap later is a one-line change) ──
const stats = [
  { n: '08', label: 'YEARS BUILDING' },
  { n: '60+', label: 'PROJECTS SHIPPED' },
  { n: '12', label: 'COUNTRIES WORKED WITH' },
  { n: '100', label: 'LIGHTHOUSE SCORE' },
];

const capabilities = [
  {
    n: '01',
    title: 'UI/UX Design',
    desc: 'Interfaces that are easy to use, look clean, and work on every screen.',
    items: ['Design systems in Figma', 'Wireframes & prototypes', 'Micro-interactions & motion', 'Accessibility (WCAG AA)'],
  },
  {
    n: '02',
    title: 'WordPress & Frontend',
    desc: 'Custom builds and frontends that hold up under real traffic.',
    items: ['Custom themes & blocks', 'ACF Pro & custom post types', 'Headless (GraphQL / REST)', 'Core Web Vitals & speed'],
  },
  {
    n: '03',
    title: 'AI Integration',
    desc: 'Practical AI that solves a real problem, not a chatbot bolted on for show.',
    items: ['LLM agents & prompting', 'RAG & vector search', 'Workflow automation', 'Realtime (WebSockets)'],
  },
];

const process = [
  { n: '01', t: 'Discover', d: 'Understand the business, the users, and what actually needs to change.' },
  { n: '02', t: 'Design', d: 'Wireframes first, then a real design system. Nothing decorative for its own sake.' },
  { n: '03', t: 'Build', d: 'Clean, accessible frontend. WordPress or headless, whichever fits.' },
  { n: '04', t: 'Ship & iterate', d: 'Launch, measure, keep improving. Handover docs and a walkthrough included.' },
];

const path = [
  { y: '2020', k: 'EDUCATION', t: 'Started the degree', d: 'Entered university and learned the fundamentals — along with the fact that I would rather be building than reading about it.', x: ['React', 'Figma'] },
  { y: '2023', k: 'EXPERIENCE', t: 'Internship', d: 'First industry role. Shipped real work, sat in real reviews, and learned how a team actually operates.', x: ['WordPress', 'JavaScript'] },
  { y: '2024', k: 'EDUCATION', t: 'Graduated, First Class', d: 'Finished with a First Class degree. Final year spent on interface design and prototyping.', x: ['Figma', 'Research'] },
  { y: '2024', k: 'EXPERIENCE', t: 'Junior Web Developer', d: 'First full-time role. WordPress builds, frontend work, and a lot of shipping.', x: ['WordPress', 'PHP'] },
  { y: 'NEXT', k: 'OPEN', t: 'Your team?', d: 'Currently open to new work. Maybe the next line on this list is with you.', x: ["Let's talk"] },
];

const radar = [
  { k: 'UI/UX', v: 88, label: 'UI/UX DESIGN', items: ['Design systems in Figma', 'Wireframes & prototyping', 'Micro-interactions', 'Accessibility (WCAG AA)'] },
  { k: 'WORDPRESS', v: 92, label: 'WORDPRESS', items: ['Custom themes & blocks', 'ACF Pro & CPTs', 'Headless REST/GraphQL', 'WooCommerce'] },
  { k: 'AI/LLM', v: 80, label: 'AI / LLM', items: ['LLM agents', 'RAG & vector search', 'Prompt engineering', 'Automation'] },
  { k: 'FRONTEND', v: 78, label: 'FRONTEND', items: ['Astro / Next.js', 'React', 'Tailwind', 'Core Web Vitals'] },
  { k: 'BACKEND', v: 74, label: 'BACKEND', items: ['PHP / MySQL', 'REST APIs', 'cPanel / Cloudflare', 'Docker'] },
];

const tools = [
  ['Fi', 'Figma'], ['Af', 'Affinity'], ['Ps', 'Photoshop'], ['Bd', 'Breakdance'], ['Dv', 'Divi'],
  ['El', 'Elementor'], ['Oc', 'OpenCode'], ['Rp', 'Replit'], ['Ag', 'Antigravity'], ['Nx', 'Next.js'],
  ['Re', 'React'], ['Tw', 'Tailwind'], ['Cp', 'cPanel'], ['Cf', 'Cloudflare'], ['Sg', 'Sendgrid'],
];

const lifePhotos = [
  '/assets/images/wc-1.jpg',
  '/assets/images/wc-3.jpg',
  '/assets/images/wc-2.jpg',
  '/assets/images/hero-1.png',
];
---

<Base title="Amiruan — Web Developer & AI Specialist" description="Creative web developer and AI specialist in Kuala Lumpur. I design, I build, I ship — WordPress, frontend and AI." current="">

  <!-- 02 Hero -->
  <section class="hero">
    <span class="hero__vline hero__vline--l" aria-hidden="true"></span>
    <span class="hero__vline hero__vline--r" aria-hidden="true"></span>

    <div class="hero__marquees" aria-hidden="true">
      <div class="hero__row marquee"><div class="marquee__track hero__track hero__track--l">
        {[0,1,2,3].map(() => <span>// WEB DEVELOPER</span>)}
      </div></div>
      <div class="hero__row marquee"><div class="marquee__track hero__track hero__track--r">
        {[0,1,2,3].map(() => <span class="hero__outline">UI/UX · WORDPRESS · AI INTEGRATION · CREATIVE</span>)}
      </div></div>
      <div class="hero__row marquee"><div class="marquee__track hero__track hero__track--l">
        {[0,1,2,3].map(() => <span>// WEB DESIGN</span>)}
      </div></div>
      <div class="hero__row marquee"><div class="marquee__track hero__track hero__track--r">
        {[0,1,2,3].map(() => <span class="hero__outline">KUALA LUMPUR · OPEN TO WORK</span>)}
      </div></div>
    </div>

    <div class="hero__top">
      <span class="u-blue">CREATIVE DEVELOPER / AI SPECIALIST</span>
      <span class="u-dim">Kuala Lumpur, Malaysia</span>
    </div>

    <figure class="hero__portrait">
      <img src="/assets/images/hero-2.png" alt="Portrait of Amiruan" width="480" height="600" />
      <span class="hero__scrim" aria-hidden="true"></span>
      <span class="hero__scan" aria-hidden="true"></span>
      <span class="hero__pgrid" aria-hidden="true"></span>
      <span class="hero__frame" aria-hidden="true"></span>
      <span class="hero__bar" aria-hidden="true"></span>
      <span class="hero__hud hero__hud--tl">AMIRUAN_002.RAW</span>
      <span class="hero__hud hero__hud--tr">● REC</span>
      <span class="hero__hud hero__hud--bl">f/1.8 1/250 ISO 400</span>
      <span class="hero__hud hero__hud--br" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
      <h1 class="hero__title">
        <span>I BUILD</span>
        <span>DIGITAL</span>
        <span class="hero__title-c">EXPERIENCES</span>
      </h1>
      <span class="hero__hud hero__hud--foot">KUALA LUMPUR · 2026</span>
    </figure>

    <div class="hero__bottom">
      <span class="u-dim">03.1390° N, 101.6869° E</span>
      <a href="#about" class="hero__scroll">SCROLL ↓</a>
    </div>
  </section>

  <!-- 03 About -->
  <section class="sec sec--paper on-paper" id="about">
    <div class="wrap">
      <p class="reveal about__statement">A designer who codes, and a developer who cares how it looks.</p>

      <div class="stats">
        {stats.map((s, i) => (
          <div class="stats__item reveal" style={`--i:${i}`}>
            <span class="stats__n">{s.n}</span>
            <span class="stats__l">{s.label}</span>
          </div>
        ))}
      </div>

      <div class="about__grid">
        <figure class="about__portrait reveal">
          <img src="/assets/images/profile.png" alt="Amiruan" width="480" height="600" loading="lazy" />
        </figure>
        <div class="about__bio">
          <p class="reveal about__cap reveal">KUALA LUMPUR, MALAYSIA · 03.1390° N, 101.6869° E</p>
          <p class="reveal about__note reveal">Currently taking on freelance work and open to full-time roles. Usually reply within a day.</p>
          <p class="reveal t-body">I got into this because I was curious why some websites feel easy to use and others feel like homework. That curiosity turned into a career.</p>
          <p class="reveal t-body">I design interfaces, build WordPress systems, and plug in AI where it actually helps. I work with founders, agencies and product teams who want something clean and fast. Not trendy for the sake of it.</p>
          <p class="reveal t-body">Off the clock I am usually reading about typography or poking at some new tool. I care about the small details that make software feel like someone actually thought about the person using it.</p>
          <a href="#" class="about__resume reveal">DOWNLOAD RESUME →</a>
        </div>
      </div>

      <header class="sec-head">
        <h2 class="t-h2 reveal">What I do</h2>
        <p class="reveal t-body about__sub">Three things, done properly. Most projects end up using two of them.</p>
      </header>

      <div class="caps">
        {capabilities.map((c, i) => (
          <article class="cap reveal" style={`--i:${i}`}>
            <span class="cap__n u-blue">{c.n}</span>
            <h3 class="t-card">{c.title}</h3>
            <p class="cap__d">{c.desc}</p>
            <ul class="cap__list">
              {c.items.map((it) => <li>{it}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="proc reveal">
        <span class="proc__label">HOW IT USUALLY GOES</span>
        <div class="proc__grid">
          {process.map((p) => (
            <div class="proc__step">
              <span class="proc__n u-blue">{p.n}</span>
              <h3 class="proc__t">{p.t}</h3>
              <p class="proc__d">{p.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Work -->
  <section class="sec sec--ink work" id="projects">
    <div class="wrap">
      <header class="sec-head sec-head--row">
        <h2 class="t-h2 reveal">Selected Work</h2>
        <span class="work__count reveal">{`(${String(featured.length).padStart(2, '0')}) · 2024—2025`}</span>
      </header>

      <div class="accordion" id="workAccordion">
        {featured.map((w, i) => (
          <article class={`acc ${i === 0 ? 'is-open' : ''}`} data-acc>
            <button class="acc__head" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class="acc__n u-blue">{String(i + 1).padStart(2, '0')}</span>
              <span class="acc__t t-card">{w.title}</span>
              <span class="acc__tag">{w.type === 'uiux' ? 'UI/UX' : w.type === 'wordpress' ? 'WordPress' : 'AI'}</span>
              <span class="acc__yr u-dim">{w.year}</span>
              <span class="acc__ic" aria-hidden="true">{i === 0 ? '—' : '+'}</span>
            </button>
            <div class="acc__body">
              <div class="acc__panel">
                {w.image
                  ? <img class="acc__img" src={w.image} alt={w.title} loading="lazy" />
                  : <div class="acc__img acc__img--ph">KIOSK · PREVIEW</div>}
                <div class="acc__info">
                  <span class="acc__fl u-blue">FEATURED PROJECT</span>
                  <p class="acc__desc">{w.subtitle}</p>
                  {w.metric && <span class="acc__metric">↑ {w.metric}</span>}
                  <a class="acc__cta" href={`/work/${w.slug}/`}>READ CASE STUDY →</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <a href="/work" class="work__all reveal">VIEW ALL WORK →</a>
    </div>
  </section>

  <!-- 05 Path -->
  <section class="sec sec--paper on-paper" id="experience">
    <div class="wrap">
      <div class="path__head reveal">
        <h2 class="t-h2">Education &amp; Experience</h2>
        <div class="path__hright">
          <p class="path__sub">Where I have worked and what I did there. Short version: I have been at this since 2018.</p>
          <a href="#" class="path__btn">
            <span>DOWNLOAD RESUME</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
          </a>
        </div>
      </div>

      <ol class="path">
        {path.map((p, i) => (
          <li class={`path__item reveal ${i % 2 ? 'path__item--flip' : ''} ${p.k === 'OPEN' ? 'is-open' : ''}`} style={`--i:${i}`}>
            <span class="path__node" aria-hidden="true"></span>
            <span class="path__tick" aria-hidden="true"></span>
            <div class="path__year">
              <span class={`path__y ${p.k === 'OPEN' ? 'u-accent' : 'u-blue'}`}>{p.y}</span>
              <span class={`path__k ${p.k === 'EDUCATION' ? 'u-blue' : 'u-dim-l'}`}>{p.k}</span>
            </div>
            <div class="path__card">
              <h3 class="path__t">{p.t}</h3>
              <p class="path__d">{p.d}</p>
              <div class="path__tags">{p.x.map((t) => <span>{t}</span>)}</div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 06 Toolbox -->
  <section class="sec sec--ink" id="stack">
    <div class="wrap">
      <header class="sec-head sec-head--row">
        <h2 class="t-h2 reveal">The Workbench</h2>
        <span class="u-dim reveal t-label">Hover an axis on the radar.</span>
      </header>

      <div class="bench">
        <div class="bench__radar reveal">
          <svg viewBox="0 0 320 320" role="img" aria-label="Skill radar">
            <g stroke="var(--line-d2)" fill="none">
              <polygon points="160,40 274,123 230,258 90,258 46,123" />
              <polygon points="160,76 245,138 213,238 107,238 75,138" />
              <polygon points="160,112 216,153 195,218 125,218 104,153" />
            </g>
            <g stroke="var(--line-d2)"><line x1="160" y1="160" x2="160" y2="40"/><line x1="160" y1="160" x2="274" y2="123"/><line x1="160" y1="160" x2="230" y2="258"/><line x1="160" y1="160" x2="90" y2="258"/><line x1="160" y1="160" x2="46" y2="123"/></g>
            <polygon class="bench__poly" points="160,54 265,127 222,246 99,246 60,127" fill="rgba(255,59,48,0.14)" stroke="var(--accent)" stroke-width="1.5"/>
            {radar.map((r, i) => {
              const ang = (-90 + i * 72) * Math.PI / 180;
              const x = 160 + Math.cos(ang) * 130;
              const y = 160 + Math.sin(ang) * 130;
              return <text class="bench__axis" x={x.toFixed(1)} y={y.toFixed(1)} text-anchor="middle" data-axis={i}>{r.k}</text>;
            })}
          </svg>
        </div>
        <div class="bench__panel reveal">
          <span class="bench__pl u-blue">{radar[0].label}</span>
          <span class="bench__pv">{radar[0].v}%</span>
          <ul id="benchList">
            {radar[0].items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      </div>

      <div class="tools reveal">
        {tools.map(([m, nm]) => (
          <div class="tool">
            <span class="tool__m">{m}</span>
            <span class="tool__n">{nm}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 07 Life Lately -->
  <section class="sec sec--paper on-paper life">
    <div class="wrap">
      <header class="sec-head sec-head--row">
        <h2 class="t-h2 reveal">Life lately</h2>
        <a href="/gallery" class="life__all reveal">SEE ALL PHOTOS →</a>
      </header>
    </div>
    <div class="life__strip marquee">
      <div class="marquee__track life__track">
        {[...lifePhotos, ...lifePhotos].map((src) => (
          <img src={src} alt="Life lately" loading="lazy" />
        ))}
      </div>
    </div>
    <div class="life__ticker marquee mt">
      <div class="marquee__track life__ttrack">
        {[0,1,2].map(() => <span>// 2025 — 2026 · 24 PHOTOS · WORDCAMP KL · STUDIO DAYS · TRIPS ·</span>)}
      </div>
    </div>
  </section>

  <ClosingCTA />
</Base>

<style>
  /* ── shared section shells ── */
  .sec { padding: 96px 0; position: relative; overflow: hidden; }
  .sec--ink { background: var(--ink); color: var(--paper); }
  .sec--paper { background: var(--paper); color: var(--ink); }
  .sec-head { margin-bottom: 56px; display: flex; flex-direction: column; gap: 12px; }
  .sec-head--row { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }

  /* ── Hero ── */
  /* Fixed 1440x1000 composition: marquee band at y312, portrait 480x600 at y200
     sitting on top of it, headline inside the portrait at y396. */
  .hero { position: relative; background: var(--ink); height: 1000px; overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: -30% -10% auto -10%; height: 150%;
    background:
      radial-gradient(45% 90% at 20% 10%, rgba(255,59,48,0.16), transparent 60%),
      radial-gradient(50% 100% at 82% 0%, rgba(77,184,255,0.16), transparent 60%);
    pointer-events: none;
  }
  .hero__vline { position: absolute; top: 0; height: 960px; width: 1px; background: #161616; }
  .hero__vline--l { left: 64px; }
  .hero__vline--r { right: 64px; }

  .hero__marquees { position: absolute; left: 0; right: 0; top: 312px; display: flex; flex-direction: column; }
  .hero__row { height: 98px; overflow: hidden; }
  .hero__track { gap: 40px; align-items: center; height: 100%; }
  .hero__track span { font-family: var(--font-mono); font-weight: 700; font-size: 62px; letter-spacing: -2px; color: #fff; white-space: nowrap; }
  .hero__outline { color: transparent !important; -webkit-text-stroke: 1px rgba(77,184,255,0.55); }
  .hero__track--l { animation: marquee 46s linear infinite; }
  .hero__track--r { animation: marqueeR 46s linear infinite; }
  @keyframes marqueeR { from { transform: translateX(-100%); } to { transform: translateX(0); } }

  .hero__portrait { position: absolute; left: 50%; top: 200px; transform: translateX(-50%); width: 480px; height: 600px; overflow: hidden; }
  .hero__portrait img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(0.95); }
  .hero__scrim { position: absolute; left: 0; right: 0; bottom: 0; height: 350px;
    background: linear-gradient(180deg, rgba(10,10,10,0) 0%, rgba(10,10,10,0.72) 55%, rgba(10,10,10,0.93) 100%); }
  .hero__scan { position: absolute; inset: 0;
    background: repeating-linear-gradient(180deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 25px); }
  .hero__pgrid { position: absolute; inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 159px, rgba(255,255,255,0.07) 159px 160px); }
  .hero__frame { position: absolute; inset: 0; border: 1px solid rgba(255,255,255,0.18); }
  .hero__bar { position: absolute; left: 0; top: 0; width: 56px; height: 3px; background: var(--accent); }

  .hero__title { position: absolute; left: 6.25%; top: 66%; display: flex; flex-direction: column;
    font-family: var(--font-display); font-weight: 700; font-size: 34px; line-height: 36px;
    letter-spacing: -0.01em; color: #fff; }
  .hero__title-c { color: var(--accent); }

  .hero__hud { position: absolute; font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--accent-blue); }
  .hero__hud--tl { left: 16px; top: 16px; }
  .hero__hud--tr { right: 16px; top: 16px; color: var(--accent); }
  .hero__hud--bl { left: 16px; top: 34px; color: var(--dim-d); }
  .hero__hud--br { right: 16px; bottom: 17px; display: flex; align-items: flex-end; gap: 4px; }
  .hero__hud--br i { display: block; width: 5px; background: var(--accent-blue); }
  .hero__hud--br i:nth-child(1) { height: 5px; }
  .hero__hud--br i:nth-child(2) { height: 8px; }
  .hero__hud--br i:nth-child(3) { height: 11px; }
  .hero__hud--br i:nth-child(4) { height: 14px; }
  .hero__hud--br i:nth-child(5) { height: 17px; }
  .hero__hud--br i:nth-child(6) { height: 20px; }
  .hero__hud--foot { left: 6.25%; top: 91%; font-size: 9px; color: rgba(255,255,255,0.6); }

  .hero__top { position: absolute; left: 64px; top: 48px; display: flex; flex-direction: column; gap: 6px;
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; }
  .hero__top .u-dim { letter-spacing: 1px; }
  .hero__bottom { position: absolute; right: 64px; top: 884px; display: flex; flex-direction: column;
    align-items: flex-end; gap: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; }
  .hero__scroll { letter-spacing: 2px; color: var(--dim-d); }

  /* ── About ── */
  .about__statement { font-family: var(--font-display); font-weight: 700; font-size: clamp(26px, 4.4vw, 64px); line-height: 1.05; letter-spacing: -0.03em; max-width: 20ch; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 56px 0; }
  .stats__item { border: 1px solid var(--line-l); padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .stats__n { font-family: var(--font-display); font-weight: 700; font-size: clamp(32px, 3.5vw, 52px); color: var(--accent-blue); letter-spacing: -0.03em; }
  .stats__l { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--dim-l); }
  .about__grid { display: grid; grid-template-columns: 320px 1fr; gap: 48px; align-items: start; }
  .about__portrait img { width: 100%; height: auto; }
  .about__bio { display: flex; flex-direction: column; gap: 16px; }
  .about__cap { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--dim-l); }
  .about__note { font-family: var(--font-body); font-size: 14px; color: var(--dim-l); }
  .about__resume { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1.5px; color: var(--accent); margin-top: 8px; }
  .about__sub { color: var(--dim-l); }

  .caps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 72px; }
  .cap { border: 1px solid var(--line-l); padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .cap__n { font-family: var(--font-mono); font-size: 11px; }
  .cap__d { font-family: var(--font-body); font-size: 14px; color: var(--dim-l); }
  .cap__list { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
  .cap__list li { font-family: var(--font-mono); font-size: 12px; color: var(--ink); border-top: 1px solid var(--line-l); padding-top: 8px; }

  .proc { margin-top: 72px; border: 1px solid var(--line-l); padding: 40px; background: var(--paper-2); }
  .proc__label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; color: var(--dim-l); }
  .proc__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 24px; }
  .proc__n { font-family: var(--font-mono); font-size: 11px; }
  .proc__t { font-family: var(--font-display); font-weight: 500; font-size: 20px; margin: 8px 0; }
  .proc__d { font-family: var(--font-body); font-size: 13px; color: var(--dim-l); }

  /* ── Work ── */
  .work__count { font-family: var(--font-mono); font-size: 12px; color: var(--dim-d); }
  .accordion { border-top: 1px solid var(--line-d2); }
  .acc { border-bottom: 1px solid var(--line-d2); }
  .acc__head { width: 100%; display: grid; grid-template-columns: 48px 1fr auto auto 40px; align-items: center; gap: 20px; padding: 28px 0; text-align: left; }
  .acc__n { font-family: var(--font-mono); font-size: 12px; }
  .acc__tag { font-family: var(--font-mono); font-size: 11px; color: var(--dim-d); letter-spacing: 1px; }
  .acc__yr { font-family: var(--font-mono); font-size: 11px; }
  .acc__ic { font-size: 22px; color: var(--accent); text-align: right; }
  .acc__body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.35s ease; }
  .acc.is-open .acc__body { grid-template-rows: 1fr; }
  .acc__panel { overflow: hidden; display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; }
  .acc__panel > * { margin-bottom: 32px; }
  .acc__img { width: 100%; height: auto; border: 1px solid var(--line-d2); }
  .acc__img--ph { aspect-ratio: 16/10; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 12px; color: var(--dim-d); }
  .acc__info { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .acc__fl { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; }
  .acc__desc { font-family: var(--font-body); font-size: 15px; color: #cfcfcf; }
  .acc__metric { font-family: var(--font-mono); font-size: 12px; color: var(--green); }
  .acc__cta { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1.5px; color: var(--accent); }
  .work__all { display: inline-block; margin-top: 40px; font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px; color: #fff; }

  /* ── Path ── */
  /* Title left, sub + filled blue resume button right; 620/72/620 rows that
     alternate sides around a centre spine. All content hugs the spine. */
  .path__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 48px; }
  .path__hright { display: flex; flex-direction: column; align-items: flex-end; gap: 18px; width: 380px; }
  .path__sub { font-family: var(--font-body); font-size: 15px; line-height: 1.6; color: var(--dim-l); }
  .path__btn { display: inline-flex; align-items: center; gap: 10px; padding: 13px 22px;
    background: var(--accent-blue); border-radius: var(--radius);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.5px; color: #fff; }

  .path { position: relative; margin-top: 64px; }
  .path::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--line-l); }

  .path__item { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 72px;
    padding: 46px 0; border-top: 1px solid var(--line-l); }

  .path__year { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; gap: 10px;
    align-items: flex-end; text-align: right; }
  .path__y { font-family: var(--font-display); font-weight: 700; font-size: 88px;
    line-height: 1; letter-spacing: -3.5px; }
  .path__k { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; }

  .path__card { grid-column: 2; grid-row: 1; display: flex; flex-direction: column; gap: 12px;
    padding: 40px 36px; background: #fff; border: 1px solid var(--line-l); border-radius: var(--radius); }
  .path__t { font-family: var(--font-display); font-weight: 500; font-size: 28px; letter-spacing: -1px; }
  .path__d { font-family: var(--font-body); font-size: 15px; line-height: 1.65; color: var(--dim-l); }
  .path__tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .path__tags span { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.5px;
    border: 1px solid var(--line-l); border-radius: var(--radius); padding: 6px 12px; color: var(--ink); }

  /* mirrored row: card left (text hugging the spine), year right */
  .path__item--flip .path__year { grid-column: 2; align-items: flex-start; text-align: left; }
  .path__item--flip .path__card { grid-column: 1; text-align: right; }
  .path__item--flip .path__tags { justify-content: flex-end; }

  .path__node { position: absolute; left: 50%; top: 115px; transform: translateX(-50%);
    width: 12px; height: 12px; border-radius: 50%; background: var(--paper);
    border: 2px solid var(--accent-blue); z-index: 1; }
  .path__item.is-open .path__node { border-color: var(--accent); background: var(--accent); }
  .path__tick { position: absolute; left: calc(50% + 7px); top: 120px; width: 35px; height: 1px; background: var(--line-l); }
  .path__item--flip .path__tick { left: auto; right: calc(50% + 7px); }

  /* ── Toolbox ── */
  .bench { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; }
  .bench__radar svg { width: 100%; max-width: 420px; }
  .bench__axis { font-family: var(--font-mono); font-size: 9px; fill: var(--dim-d); letter-spacing: 1px; }
  .bench__panel { border: 1px solid var(--line-d2); padding: 32px; display: flex; flex-direction: column; gap: 12px; }
  .bench__pl { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1px; }
  .bench__pv { font-family: var(--font-display); font-weight: 700; font-size: 40px; }
  #benchList { display: flex; flex-direction: column; gap: 8px; }
  #benchList li { font-family: var(--font-mono); font-size: 12px; color: #cfcfcf; border-top: 1px solid var(--line-d2); padding-top: 8px; }
  .tools { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-top: 56px; }
  .tool { border: 1px solid var(--line-d2); padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .tool__m { font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--accent); }
  .tool__n { font-family: var(--font-mono); font-size: 11px; color: var(--dim-d); }

  /* ── Life ── */
  .life__all { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1.5px; color: var(--accent); }
  .life__strip { margin: 24px 0; }
  .life__track { display: flex; gap: 16px; animation-duration: 50s; }
  .life__track img { height: 260px; width: auto; object-fit: cover; }
  .life__ticker { border-top: 1px solid var(--line-l); padding: 16px 0; }
  .life__ttrack { gap: 40px; }
  .life__ttrack span { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1px; color: var(--dim-l); white-space: nowrap; }

  /* ── Responsive ── */
  /* ── Hero below the fixed 1440 composition: becomes a flow layout ── */
  @media (max-width: 1100px) {
    .hero { height: auto; padding: 28px 0 40px; display: flex; flex-direction: column; gap: 26px; }
    .hero__vline { display: none; }
    .hero__marquees { position: static; }
    .hero__row { height: 56px; }
    .hero__track { gap: 24px; }
    .hero__track span { font-size: 32px; letter-spacing: -1px; }
    .hero__top { position: static; padding-inline: var(--pad); }
    .hero__portrait { position: relative; left: auto; top: auto; transform: none;
      margin-inline: auto; width: min(480px, calc(100% - 2 * var(--pad))); height: auto; aspect-ratio: 480 / 600; }
    .hero__bottom { position: static; align-items: flex-start; padding-inline: var(--pad); }
    .hero__title { font-size: 26px; line-height: 28px; }
    .hero__hud { font-size: 9px; }
  }

  @media (max-width: 560px) {
    .hero__title { font-size: 18px; line-height: 20px; }
    .hero__hud--bl { display: none; }
  }

  @media (max-width: 900px) {
    .sec { padding: 64px 0; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .about__grid { grid-template-columns: 1fr; }
    .caps { grid-template-columns: 1fr; }
    .proc__grid { grid-template-columns: 1fr 1fr; }
    .acc__head { grid-template-columns: 32px 1fr 40px; }
    .acc__tag, .acc__yr { display: none; }
    .acc__panel { grid-template-columns: 1fr; }
    .path__head { flex-direction: column; gap: 24px; }
    .path__hright { align-items: flex-start; width: 100%; }
    .path::before, .path__node, .path__tick { display: none; }
    .path__item { display: grid; grid-template-columns: 1fr; gap: 16px; padding: 32px 0; }
    .path__year, .path__item--flip .path__year {
      grid-column: 1; grid-row: auto; align-items: flex-start; text-align: left; }
    .path__card, .path__item--flip .path__card {
      grid-column: 1; grid-row: auto; text-align: left; }
    .path__item--flip .path__tags { justify-content: flex-start; }
    .path__y { font-size: 56px; letter-spacing: -2px; }
    .bench { grid-template-columns: 1fr; }
    .tools { grid-template-columns: repeat(3, 1fr); }
    .life__track img { height: 180px; }
  }
</style>

<script>
  // Work accordion
  document.querySelectorAll('[data-acc] .acc__head').forEach((head) => {
    head.addEventListener('click', () => {
      const item = head.closest('[data-acc]');
      const open = item?.classList.contains('is-open');
      document.querySelectorAll('[data-acc]').forEach((a) => {
        a.classList.remove('is-open');
        a.querySelector('.acc__head')?.setAttribute('aria-expanded', 'false');
      });
      if (!open && item) {
        item.classList.add('is-open');
        head.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Toolbox radar hover → swap panel
  const radar = [
    { label: 'UI/UX DESIGN', v: 88, items: ['Design systems in Figma', 'Wireframes & prototyping', 'Micro-interactions', 'Accessibility (WCAG AA)'] },
    { label: 'WORDPRESS', v: 92, items: ['Custom themes & blocks', 'ACF Pro & CPTs', 'Headless REST/GraphQL', 'WooCommerce'] },
    { label: 'AI / LLM', v: 80, items: ['LLM agents', 'RAG & vector search', 'Prompt engineering', 'Automation'] },
    { label: 'FRONTEND', v: 78, items: ['Astro / Next.js', 'React', 'Tailwind', 'Core Web Vitals'] },
    { label: 'BACKEND', v: 74, items: ['PHP / MySQL', 'REST APIs', 'cPanel / Cloudflare', 'Docker'] },
  ];
  const pl = document.querySelector('.bench__pl');
  const pv = document.querySelector('.bench__pv');
  const bl = document.getElementById('benchList');
  document.querySelectorAll('.bench__axis').forEach((el) => {
    const activate = () => {
      const i = Number(el.getAttribute('data-axis'));
      const r = radar[i];
      if (!r || !pl || !pv || !bl) return;
      pl.textContent = r.label;
      pv.textContent = r.v + '%';
      bl.innerHTML = r.items.map((t) => `<li>${t}</li>`).join('');
    };
    el.addEventListener('mouseenter', activate);
    el.addEventListener('click', activate);
  });
</script>
