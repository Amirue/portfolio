---
import Base from '../components/layout/Base.astro';
import Glow from '../components/layout/Glow.astro';
import TextLoop from '../components/layout/TextLoop.astro';
import KioskMock from '../components/KioskMock.astro';
import { fetchWorksData } from '../lib/wordpress';
import { axes } from '../data/toolbox';

// Replaces the old top marquee ticker — same copy, cycled one phrase at a time in
// the hero instead of scrolling across the navbar.
const tickerPhrases = [
  'Web dev on a slow day',
  'Currently arguing with CSS',
  'This ships rough on purpose',
  'Built with caffeine and spite',
  'If it looks half-done, it probably is',
  'Designers never finish their own portfolio',
  'Open to work (and snacks)',
  'Yes, I built this myself',
];

const works = await fetchWorksData();
const featured = works.slice(0, 3);

// ── Static copy (declared here so a CPT swap later is a one-line change) ──
const stats = [
  { n: '03', label: 'YEARS IN WORDPRESS' },
  { n: '20+', label: 'WEBSITES PUBLISHED' },
  { n: '80K', label: 'EMAILS HANDLED' },
  { n: '10+', label: 'EVENTS DELIVERED' },
];

const capabilities = [
  {
    n: '01',
    title: 'UI/UX Design',
    desc: 'Interfaces that are easy to use, look clean, and hold up on every screen.',
    items: ['Design systems in Figma', 'Wireframes & prototypes', 'Affinity · Photoshop · Illustrator', 'Accessibility (WCAG AA)'],
  },
  {
    n: '02',
    title: 'WordPress & Web Development',
    desc: 'Custom builds and client platforms that survive real traffic.',
    items: ['Breakdance, Elementor Pro & Divi', 'HTML, CSS, JavaScript, PHP, MySQL', 'cPanel, WHM & Cloudflare', 'SendGrid & Stripe integrations'],
  },
  {
    n: '03',
    title: 'AI-Assisted Development',
    desc: 'Practical AI and modern tooling that gets working software out faster.',
    items: ['Replit & OpenCode', 'Node.js & PostgreSQL', 'LLM agents & prompting', 'Workflow automation'],
  },
];

const process = [
  { n: '01', t: 'Discover', d: 'Understand the business, the users, and what actually needs to change.' },
  { n: '02', t: 'Design', d: 'Wireframes first, then a real design system. Nothing decorative for its own sake.' },
  { n: '03', t: 'Build', d: 'Clean, accessible frontend. WordPress or headless, whichever fits.' },
  { n: '04', t: 'Ship & iterate', d: 'Launch, measure, keep improving. Handover docs and a walkthrough included.' },
];

const path = [
  { y: '2020', k: 'EDUCATION', t: 'UTM — Software Engineering', d: 'Started a Software Engineering degree at Universiti Teknologi Malaysia, Skudai, Johor.', x: ['Software Engineering', 'UTM'], img: '/assets/images/hero-1.png' },
  { y: '2022', k: 'EXPERIENCE', t: 'Orchestra Instructor', d: 'Taught woodwind and ran rehearsals at SM Sains Raja Tun Azlan Shah, Taiping — including state-level performances.', x: ['Taiping, Perak'], img: '/assets/images/wc-2.jpg' },
  { y: '2023', k: 'EXPERIENCE', t: 'Web Designer & Developer — Internship', d: 'At Lumen7, Shah Alam, shipped client sites — Theta Edge, Sime Darby Energy Solutions, AEON — and design systems in Figma.', x: ['WordPress', 'Figma'], img: '/assets/images/wc-1.jpg' },
  { y: '2024', k: 'EDUCATION', t: 'Graduated — CGPA 3.80', d: 'First Class honours and Dean\u2019s List for seven semesters. Final year project: Sembang Kamus, an AI chatbot for DBP\u2019s dictionary.', x: ['Dean\u2019s List', 'AI'], img: '/assets/images/hero-3.png' },
  { y: '2024', k: 'EXPERIENCE', t: 'Junior Web Developer & Designer', d: 'At Light Up 7, Kuala Lumpur — client WordPress platforms for Bank Negara Malaysia, FENetwork and PETRONAS/TFM, an event badge-printing system, and an e-learning platform serving 20,000+ students.', x: ['WordPress', 'Node.js'], img: '/assets/images/wc-3.jpg' },
  { y: '2025', k: 'EXPERIENCE', t: 'Freelance Chess Coach', d: 'Coaching youth players in tactical strategy, opening theory and post-game analysis at XChess Academy, online.', x: ['XChess Academy'], img: '/assets/images/hero-2.png' },
  { y: 'NEXT', k: 'OPEN', t: 'Your team?', d: 'Currently open to new work. Maybe the next line on this list is with you.', x: ["Let's talk"], img: '/assets/images/hero-2.png' },
];

const radar = axes.map((a) => ({ k: a.short, v: a.v, label: a.label, items: a.items }));

// Radar geometry (viewBox 0 0 320 320)
const RC = 160;
const RR = 140;
const polar = (i: number, r: number) => {
  const a = ((-90 + i * 72) * Math.PI) / 180;
  return [(RC + Math.cos(a) * r).toFixed(1), (RC + Math.sin(a) * r).toFixed(1)];
};
const pt = polar;
const ringPts = (r: number) => axes.map((_, i) => polar(i, r).join(',')).join(' ');
const dataPts = axes.map((a, i) => polar(i, (RR * a.v) / 100).join(',')).join(' ');
const panelData = axes.map((a) => ({ label: a.label, v: a.v, items: a.items }));

const lifePhotos = [
  '/assets/images/wc-1.jpg',
  '/assets/images/wc-3.jpg',
  '/assets/images/wc-2.jpg',
  '/assets/images/hero-1.png',
];
---

<Base title="Amiruan — Web Developer & AI Specialist" description="Creative web developer and AI specialist in Kuala Lumpur. I design, I build, I ship — WordPress, frontend and AI." current="">

  <!-- 02 Hero -->
  <section class="hero">
    <Glow variant="a" />
    <span class="hero__vline hero__vline--l" aria-hidden="true"></span>
    <span class="hero__vline hero__vline--r" aria-hidden="true"></span>

    <div class="hero__marquees" aria-hidden="true">
      <div class="hero__row marquee"><div class="marquee__track hero__track hero__track--l">
        {[0,1,2,3,4,5].map(() => <span>// WEB DEVELOPER</span>)}
      </div></div>
      <div class="hero__row marquee"><div class="marquee__track hero__track hero__track--r">
        {[0,1,2,3,4,5].map(() => <span class="hero__outline">UI/UX · WORDPRESS · AI INTEGRATION · CREATIVE</span>)}
      </div></div>
      <div class="hero__row marquee"><div class="marquee__track hero__track hero__track--l">
        {[0,1,2,3,4,5].map(() => <span>// WEB DESIGN</span>)}
      </div></div>
      <div class="hero__row marquee"><div class="marquee__track hero__track hero__track--r">
        {[0,1,2,3,4,5].map(() => <span class="hero__outline">KUALA LUMPUR · OPEN TO WORK</span>)}
      </div></div>
    </div>

    <div class="hero__top">
      <TextLoop items={tickerPhrases} class="hero__ticker" />
      <span class="u-dim">Kuala Lumpur, Malaysia</span>
    </div>

    <figure class="hero__portrait">
      <img src="https://wp.amiruan.site/wp-content/uploads/2026/10/amiruan-1.jpg" alt="Portrait of Amiruan" width="370" height="462" />
      <span class="hero__scrim" aria-hidden="true"></span>
      <span class="hero__scan" aria-hidden="true"></span>
      <span class="hero__pgrid" aria-hidden="true"></span>
      <span class="hero__frame" aria-hidden="true"></span>
      <span class="hero__bar" aria-hidden="true"></span>
      <h1 class="hero__title">
        <span>I BUILD</span>{' '}
        <span>DIGITAL</span>{' '}
        <span class="hero__title-c">EXPERIENCES</span>
      </h1>
      <span class="hero__hud hero__hud--foot">KUALA LUMPUR · 2026</span>
    </figure>

    <div class="hero__bottom">
      <span class="u-dim">03.1390° N, 101.6869° E</span>
      <a href="#about" class="hero__scroll">SCROLL ↓</a>
    </div>
  </section>

  <!-- 03 About -->
  <section class="about" id="about">
    <!-- WhoIAm -->
    <div class="who wrap">
      <div class="who__top">
        <p class="reveal who__statement">A designer who codes, and a developer who cares how it looks.</p>
        <a href="https://wp.amiruan.site/wp-content/uploads/2026/10/Resume_Muhammad_Amiruddin_Bin_Zulkifli-1.pdf" target="_blank" rel="noopener noreferrer" class="reveal who__resume">DOWNLOAD RESUME</a>
      </div>

      <div class="who__facts">
        {stats.map((s, i) => (
          <div class="fact reveal" style={`--i:${i}`}>
            <span class="fact__n" data-count={s.n}>{s.n}</span>
            <span class="fact__l">{s.label}</span>
          </div>
        ))}
      </div>

      <div class="who__body">
        <div class="who__left">
          <figure class="reveal who__portrait">
            <img src="https://wp.amiruan.site/wp-content/uploads/2026/10/profile.jpg" alt="Amiruan" width="520" height="340" loading="lazy" />
          </figure>
          <p class="reveal who__cap">KUALA LUMPUR, MALAYSIA · 03.1390° N, 101.6869° E</p>
          <p class="reveal who__note">Currently taking on freelance work and open to full-time roles. Usually reply within a day.</p>
        </div>
        <div class="who__right">
          <p class="reveal t-body">I am a web developer and designer from Kuala Lumpur with a Software Engineering degree from UTM. I build production websites — mostly on WordPress — and I care how they look as much as how they run.</p>
          <p class="reveal t-body">Day to day I do everything from client site maintenance to shipping custom products: an automated badge-printing system for live events, an e-learning platform used by more than 20,000 students, and the design systems behind them. I work in Figma, build with WordPress and modern JavaScript, and lean on AI tooling where it genuinely speeds things up.</p>
          <p class="reveal t-body">Off the clock I read about typography, play chess, and poke at whatever new tool caught my eye. I care about the small details that make software feel like someone actually thought about the person using it.</p>
        </div>
      </div>
    </div>

    <!-- WhatIDo -->
    <div class="what wrap">
      <header class="what__head reveal">
        <h2 class="what__title">What I do</h2>
        <p class="what__sub">Three things, done properly. Most projects end up using two of them.</p>
      </header>

      <div class="what__grid" data-slider>
        {capabilities.map((c, i) => (
          <article class="cap reveal" style={`--i:${i}`}>
            <span class="cap__n">{c.n}</span>
            <h3 class="cap__t">{c.title}</h3>
            <p class="cap__d">{c.desc}</p>
            <ul class="cap__list">
              {c.items.map((it) => <li>{it}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="proc">
        <span class="proc__label">HOW IT USUALLY GOES</span>
        <div class="proc__steps">
          {process.map((p, i) => (
            <div class="proc__step reveal" style={`--i:${i}`}>
              <span class="proc__n">{p.n}</span>
              <span class="proc__dot" aria-hidden="true"></span>
              <div class="proc__body">
                <h3 class="proc__t">{p.t}</h3>
                <p class="proc__d">{p.d}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Work -->
  <section class="sec sec--ink work" id="projects">
    <Glow variant="dark" />
    <div class="wrap">
      <header class="sec-head sec-head--row">
        <h2 class="t-h2 reveal">Selected Work</h2>
        <span class="work__count reveal">{`(${String(featured.length).padStart(2, '0')}) · 2024—2025`}</span>
      </header>

      <div class="accordion" id="workAccordion">
        {featured.map((w, i) => (
          <article class={`acc ${i === 0 ? 'is-open' : ''}`} data-acc>
            <button class="acc__head" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class="acc__n u-blue">{String(i + 1).padStart(2, '0')}</span>
              <span class="acc__t t-card">{w.title}</span>
              <span class="acc__tag">{w.type === 'uiux' ? 'UI/UX' : w.type === 'wordpress' ? 'WordPress' : 'AI'}</span>
              <span class="acc__yr u-dim">{w.year}</span>
              <span class="acc__ic" aria-hidden="true">{i === 0 ? '—' : '+'}</span>
            </button>
            <div class="acc__body">
              <div class="acc__panel">
                {w.slug === 'ai-kiosk-interface'
                  ? <KioskMock />
                  : w.image
                    ? <img class="acc__img" src={w.image} alt={w.title} loading="lazy" />
                    : <div class="acc__img acc__img--ph">PREVIEW SOON</div>}
                <div class="acc__info">
                  <span class="acc__fl u-blue">FEATURED PROJECT</span>
                  <p class="acc__desc">{w.subtitle}</p>
                  {w.metric && <span class="acc__metric">↑ {w.metric}</span>}
                  <a class="acc__cta" href={`/work/${w.slug}/`}>READ CASE STUDY →</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <a href="/work" class="work__all reveal">VIEW ALL WORK →</a>
    </div>
  </section>

  <!-- 05 Path — pinned scroll: the section holds, the entries swap -->
  <section class="pathsec on-paper" id="experience">
    <div class="pathpin" data-pin style={`--n:${path.length}`}>
      <div class="pathpin__stage">
        <div class="wrap pathpin__inner">
          <div class="path__head reveal">
            <h2 class="t-h2">Education &amp; Experience</h2>
            <div class="path__hright">
              <p class="path__sub">The road so far — where I studied, where I shipped, and what each stop taught me.</p>
              <a href="https://wp.amiruan.site/wp-content/uploads/2026/10/Resume_Muhammad_Amiruddin_Bin_Zulkifli-1.pdf" target="_blank" rel="noopener noreferrer" class="path__btn">
                <span>DOWNLOAD RESUME</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
              </a>
            </div>
          </div>

          <div class="pathstage" data-pathstage>
            {path.map((p, i) => (
              <article
                class={`pentry ${i % 2 ? 'pentry--flip' : ''} ${p.k === 'OPEN' ? 'is-open' : ''}`}
                data-pentry={i}
                data-img={p.img}
                data-label="1 PHOTO"
              >
                <span class="pentry__node" aria-hidden="true"></span>
                <span class="pentry__tick" aria-hidden="true"></span>
                <div class="pentry__year">
                  <span class={`pentry__y ${p.k === 'OPEN' ? 'u-accent' : 'u-blue'}`}>{p.y}</span>
                  <span class={`pentry__k ${p.k === 'EDUCATION' ? 'u-blue' : 'u-dim-l'}`}>{p.k}</span>
                </div>
                <div class="pentry__card">
                  <h3 class="pentry__t">{p.t}</h3>
                  <p class="pentry__d">{p.d}</p>
                  <div class="pentry__tags">{p.x.map((t) => <span>{t}</span>)}</div>
                </div>
              </article>
            ))}
          </div>

          <div class="pathdots" data-pathdots aria-hidden="true">
            {path.map((p, i) => <span class={`pathdot ${i === 0 ? 'is-active' : ''}`} data-pathdot={i}></span>)}
          </div>
        </div>
      </div>
    </div>

    <!-- Cursor card: trails the pointer with spring physics (design z8JT6T) -->
    <div class="pcursor" data-cursor aria-hidden="true">
      <div class="pcursor__inner">
        <div class="pcursor__photo"><img data-cursor-img src={path[0].img} alt="" width="241" height="167" /></div>
        <div class="pcursor__foot">
          <span data-cursor-label>1 PHOTO</span>
          <span class="pcursor__cta">CLICK TO SEE MORE →</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Toolbox -->
  <section class="sec sec--ink toolbox" id="stack">
    <Glow variant="dark" />
    <div class="wrap">
      <header class="sec-head sec-head--row">
        <h2 class="t-h2 reveal">The Workbench</h2>
        <p class="bench__sub reveal">Hover an axis on the radar. Whatever you point at shows the stack behind it.</p>
      </header>

      <div class="bench reveal">
        <div class="bench__radar">
          <svg viewBox="-44 -26 408 392" role="img" aria-label="Skill radar">
            <g class="bench__rings" stroke="var(--line-d2)" fill="none">
              <polygon points={ringPts(140)} />
              <polygon points={ringPts(100)} />
              <polygon points={ringPts(60)} />
            </g>
            <g class="bench__spokes" stroke="var(--line-d2)">
              {axes.map((_, i) => { const [x, y] = pt(i, 140); return <line x1="160" y1="160" x2={x} y2={y} />; })}
            </g>
            <polygon class="bench__data" points={dataPts} />
            {axes.map((a, i) => {
              const [x, y] = pt(i, 158);
              return <text class="bench__axis" x={x} y={y} text-anchor="middle" dominant-baseline="middle" data-axis={i}>{a.short}</text>;
            })}
          </svg>
        <div class="bench__panel" id="benchPanel">
          <div class="bench__ph">
            <span class="bench__pl u-blue" id="benchLabel">{axes[0].label}</span>
            <span class="bench__pv" id="benchPct">{axes[0].v}%</span>
          </div>
          <ul id="benchList">
            {axes[0].items.map((it) => (
              <li><span>{it}</span><span class="bench__bar"><i style={`width:${axes[0].v}%`}></i></span></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="tooltabs" role="tablist" aria-label="Filter tools">
        {axes.map((a, ai) => (
          <button
            class={`tooltab ${ai === 0 ? 'is-active' : ''}`}
            role="tab"
            aria-selected={ai === 0 ? 'true' : 'false'}
            data-tooltab={ai}
          >
            {a.short}
          </button>
        ))}
      </div>

      <div class="axes" id="axesGrid">
        {axes.flatMap((a, ai) => a.tools.map((t) => (
          <div class={`tool ${ai === 0 ? 'is-active' : ''}`} data-axis={ai}>
                  <div class="tool__top">
                    <span class="tool__n">{t.n}</span>
                    {t.logo
                      ? <svg class="tool__logo" viewBox="0 0 24 24" aria-hidden="true"><path d={t.logo} /></svg>
                      : <span class="tool__logo tool__logo--none" aria-hidden="true" />}
                  </div>
                  <span class="tool__m">{t.letter}</span>
              <span class="tool__nm">{t.name}</span>
            </div>
          )))}
        </div>
      </div>
    </div>
  </section>

  <!-- 07 Life Lately -->
  <section class="sec sec--paper on-paper life">
    <div class="wrap">
      <header class="sec-head sec-head--row">
        <h2 class="t-h2 reveal">Life lately</h2>
        <a href="/gallery" class="life__all reveal">SEE ALL PHOTOS →</a>
      </header>
    </div>
    <div class="life__strip marquee">
      <div class="marquee__track life__track">
        {[...lifePhotos, ...lifePhotos, ...lifePhotos, ...lifePhotos].map((src) => (
          <img src={src} alt="Life lately" loading="lazy" />
        ))}
      </div>
    </div>
    <div class="life__ticker marquee mt">
      <div class="marquee__track life__ttrack">
        {[0,1,2,3,4,5].map(() => <span>// 2025 — 2026 · 24 PHOTOS · WORDCAMP KL · STUDIO DAYS · TRIPS ·</span>)}
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── shared section shells ── */
  .sec { padding: 96px 0; position: relative; overflow: hidden; }
  .sec > .wrap { position: relative; z-index: 1; }
  .sec--ink { background: var(--ink); color: var(--paper); }
  .sec--paper { background: var(--paper); color: var(--ink); }
  .sec-head { margin-bottom: 56px; display: flex; flex-direction: column; gap: 12px; }
  .sec-head--row { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }

  /* ── Hero ── */
  /* Composition: marquee band centred behind a 480x600 portrait, headline inside the
     portrait. Height tracks the space below the 76px sticky header (clamped 680–1000)
     so the portrait + marquee stay vertically centred on laptops instead of sitting low
     in a fixed 1000px box. */
  .hero {
    position: relative;
    background: var(--ink);
    height: clamp(680px, calc(100vh - 76px), 1000px);
    height: clamp(680px, calc(100svh - 76px), 1000px);
    overflow: hidden;
  }
  .hero__vline { position: absolute; top: 0; height: calc(100% - 40px); width: 1px; background: #161616; }
  .hero__vline--l { left: 64px; }
  .hero__vline--r { right: 64px; }

  .hero__marquees { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; }
  .hero__row { height: 98px; overflow: hidden; }
  .hero__track { align-items: center; height: 100%; }
  .hero__track span { font-family: var(--font-mono); font-weight: 700; font-size: 62px; letter-spacing: -2px; color: #fff; white-space: nowrap; }
  /* Design rows 2 and 4 are faint SOLID white, not blue outlines:
     row 2 = #FFFFFF21 (13%), row 4 = #FFFFFF1A (10%). The class name is historical. */
  .hero__row:nth-child(2) { --row-fill: rgba(255, 255, 255, 0.129); }
  .hero__row:nth-child(4) { --row-fill: rgba(255, 255, 255, 0.102); }
  .hero__outline { color: var(--row-fill, rgba(255, 255, 255, 0.129)) !important; }
  .hero__track--l { animation: marquee 46s linear infinite; }
  .hero__track--r { animation: marqueeR 46s linear infinite; }

  .hero__portrait { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 370px; height: 462px; overflow: hidden; }
  .hero__portrait img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.05) saturate(0.95); }
  .hero__scrim { position: absolute; left: 0; right: 0; bottom: 0; height: 270px;
    background: linear-gradient(180deg, rgba(10,10,10,0) 0%, rgba(10,10,10,0.72) 55%, rgba(10,10,10,0.93) 100%); }
  .hero__scan { position: absolute; inset: 0;
    background: repeating-linear-gradient(180deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 25px); }
  .hero__pgrid { position: absolute; inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 159px, rgba(255,255,255,0.07) 159px 160px); }
  .hero__frame { position: absolute; inset: 0; border: 1px solid rgba(255,255,255,0.18); }
  .hero__bar { position: absolute; left: 0; top: 0; width: 56px; height: 3px; background: var(--accent); }

  .hero__title { position: absolute; left: 6.25%; top: 66%; display: flex; flex-direction: column;
    font-family: var(--font-display); font-weight: 700; font-size: 34px; line-height: 36px;
    letter-spacing: -0.01em; color: #fff; }
  .hero__title-c { color: var(--accent); }

  .hero__hud { position: absolute; font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--accent-blue); }
  .hero__hud--foot { left: 6.25%; bottom: 10px; font-size: 9px; color: rgba(255,255,255,0.6); }

  .hero__top { position: absolute; left: 64px; top: 48px; display: flex; flex-direction: column; gap: 6px;
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; }
  .hero__ticker { color: var(--accent-blue); letter-spacing: 2px; }
  .hero__top .u-dim { letter-spacing: 1px; }
  .hero__bottom { position: absolute; right: 64px; bottom: 86px; display: flex; flex-direction: column;
    align-items: flex-end; gap: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; }
  .hero__scroll { letter-spacing: 2px; color: var(--dim-d); }

  /* ── About: WhoIAm + WhatIDo ── */
  .about { background: var(--paper); color: var(--ink); }
  .who { padding: 160px var(--pad) 80px; }
  .what { padding: 80px var(--pad) 160px; }

  .who__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 48px; }
  /* Design: 58px in a 1020px box lands on exactly 2 lines — no orphaned word. */
  .who__statement {
    font-family: var(--font-display); font-weight: 700;
    font-size: 58px; line-height: 1.04; letter-spacing: -2.5px;
    max-width: 1020px;
  }
  .who__resume {
    flex: none; display: inline-flex; align-items: center; gap: 10px;
    padding: 14px 24px; background: var(--accent-blue); border-radius: var(--radius);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.5px; color: #fff;
  }

  /* WFacts — dark tiles sitting flush between two rules, as in the design. */
  .who__facts {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
    margin-top: 40px;
    border-top: 1px solid var(--line-l);
    border-bottom: 1px solid var(--line-l);
  }
  .fact { background: var(--tile); padding: 26px 24px; display: flex; flex-direction: column; gap: 12px; }
  .fact__n { font-family: var(--font-display); font-weight: 700; font-size: 42px; line-height: 1; color: var(--accent); letter-spacing: -1px; font-variant-numeric: tabular-nums; }
  .fact__l { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1.5px; color: var(--dim-d); }

  .who__body { display: grid; grid-template-columns: 520px 1fr; gap: 80px; margin-top: 64px; align-items: start; }
  .who__left { display: flex; flex-direction: column; gap: 18px; }
  .who__portrait { height: 340px; border-radius: var(--radius); overflow: hidden; }
  .who__portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .who__cap { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--dim-l); }
  .who__note { font-family: var(--font-body); font-size: 14px; line-height: 1.55; color: var(--dim-l); }
  .who__right { display: flex; flex-direction: column; gap: 22px; }

  /* Heading hard left, supporting line hard right and bottom-aligned (design WhatHead). */
  .what__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 72px; }
  .what__title { font-family: var(--font-display); font-weight: 700; font-size: 80px; line-height: 1; letter-spacing: -3px; }
  .what__sub { width: 380px; max-width: 100%; font-family: var(--font-body); font-size: 15px; line-height: 1.6; color: var(--dim-l); }

  .what__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 64px; }

  /* Capability cards.
     Hover (desktop) or active-slide (mobile) fills the card with --orange. The
     fill is painted by ::before with a negative inset so it bleeds past the content
     without changing layout — padding the card instead would shift the text on hover.
     Text colours go through custom properties so one state switch recolours everything.
     Ink at partial alpha keeps contrast on orange (full ink is ~7:1, dim grey ~2:1). */
  .cap {
    position: relative;
    isolation: isolate;
    border-top: 1px solid var(--line-d);
    padding-top: 36px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    --cap-n: var(--accent-blue);
    --cap-d: var(--dim-l);
    --cap-rule: var(--line-l);
  }
  .cap::before {
    content: '';
    position: absolute;
    inset: -28px -20px -24px;
    background: var(--orange);
    border-radius: var(--radius);
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: -1;
  }
  @media (hover: hover) {
    .cap:hover::before { opacity: 1; }
    .cap:hover {
      --cap-n: rgba(10, 10, 10, 0.62);
      --cap-d: rgba(10, 10, 10, 0.74);
      --cap-rule: rgba(10, 10, 10, 0.18);
    }
  }
  .cap.is-active::before { opacity: 1; }
  .cap.is-active {
    --cap-n: rgba(10, 10, 10, 0.62);
    --cap-d: rgba(10, 10, 10, 0.74);
    --cap-rule: rgba(10, 10, 10, 0.18);
  }

  .cap__n { font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; color: var(--cap-n); transition: color 0.25s ease; }
  .cap__t { font-family: var(--font-display); font-weight: 500; font-size: 28px; line-height: 1.15; letter-spacing: -1px; }
  .cap__d { font-family: var(--font-body); font-size: 15px; line-height: 1.55; color: var(--cap-d); transition: color 0.25s ease; }
  .cap__list { display: flex; flex-direction: column; }
  .cap__list li { font-family: var(--font-body); font-size: 13.5px; color: var(--cap-d); border-top: 1px solid var(--cap-rule); padding: 11px 0; transition: color 0.25s ease, border-color 0.25s ease; }

  /* Process — dark card, horizontal rail with coral node dots */
  .proc { margin-top: 72px; background: var(--tile); border: 1px solid var(--line-d2); border-radius: var(--radius);
    padding: 36px 32px; display: flex; flex-direction: column; gap: 30px; }
  .proc__label { align-self: flex-start; padding: 9px 14px; background: #1B1B22; border: 1px solid #33333D;
    border-radius: var(--radius); font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; color: var(--dim-d); }
  .proc__steps { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; }
  .proc__steps::before { content: ''; position: absolute; left: 0; right: 0; top: 30px; height: 1px; background: #FFFFFF1F; }
  .proc__step { position: relative; display: flex; flex-direction: column; }
  .proc__n { font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; color: var(--accent-blue); }
  .proc__dot { width: 13px; height: 13px; border-radius: 50%; background: var(--tile);
    border: 2px solid var(--accent); margin-top: 11px; }
  .proc__body { display: flex; flex-direction: column; gap: 8px; margin-top: 27px; }
  .proc__t { font-family: var(--font-display); font-weight: 500; font-size: 20px; color: #fff; }
  .proc__d { font-family: var(--font-body); font-size: 13px; line-height: 1.6; color: var(--dim-d); }

  /* ── Work ── */
  .work__count { font-family: var(--font-mono); font-size: 12px; color: var(--dim-d); }
  .accordion { border-top: 1px solid var(--line-d2); }
  .acc { background: var(--tile); border-top: 1px solid var(--line-d2); border-bottom: 1px solid var(--line-d2);
    padding: 0 40px; display: flex; flex-direction: column; gap: 6px; }
  .acc__head { width: 100%; display: grid; grid-template-columns: 48px 1fr auto auto 40px; align-items: center; gap: 20px; padding: 36px 0; text-align: left; }
  .acc__n { font-family: var(--font-mono); font-size: 12px; }
  .acc__tag { font-family: var(--font-mono); font-size: 11px; color: var(--dim-d); letter-spacing: 1px; }
  .acc__yr { font-family: var(--font-mono); font-size: 11px; }
  .acc__ic { font-size: 22px; color: var(--accent); text-align: right; }
  .acc__body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.35s ease; }
  .acc.is-open .acc__body { grid-template-rows: 1fr; }
  .acc__panel { overflow: hidden; display: grid; grid-template-columns: 620px 1fr; gap: 48px; padding-bottom: 48px; }
  .acc__img { width: 100%; height: auto; border: 1px solid var(--line-d2); background: #0D0D12; }
  .acc__img--ph { aspect-ratio: 620 / 412; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 12px; color: var(--dim-d); }
  .acc__info { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .acc__fl { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; }
  .acc__desc { font-family: var(--font-body); font-size: 15px; color: #cfcfcf; }
  .acc__metric { font-family: var(--font-mono); font-size: 12px; color: var(--green); }
  .acc__cta { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1.5px; color: var(--accent); }
  .work__all { display: inline-block; margin-top: 40px; font-family: var(--font-mono); font-size: 13px; letter-spacing: 2px; color: #fff; }

  /* ── Path ── */
  /* Title left; sub + filled blue resume button hard right, all top-aligned
     with the section (design: section pad-top 160, PathHead at y160). */
  .pathsec { background: var(--paper); color: var(--ink); padding: 160px 0 100px; }
  .pathsec > .wrap { position: relative; z-index: 1; }
  .path__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 48px; }
  .path__hright { display: flex; flex-direction: column; align-items: flex-end; gap: 18px; width: 380px; }
  .path__sub { font-family: var(--font-body); font-size: 15px; line-height: 1.6; color: var(--dim-l); }
  .path__btn { display: inline-flex; align-items: center; gap: 10px; padding: 11px 22px;
    background: var(--accent-blue); border-radius: var(--radius);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.5px; color: #fff; }

  /* ── Path stage ─────────────────────────────────────────────────────────────
     Default (mobile / reduced-motion / no JS) is a plain stacked list.
     .is-pinned turns it into a sticky stage where entries cross-fade + slide. */
  .pathstage { position: relative; margin-top: 64px; display: flex; flex-direction: column; gap: 24px; }

  .pentry { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 72px;
    padding: 46px 0; border-top: 1px solid var(--line-l); }

  .pentry__year { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; gap: 10px;
    align-items: flex-end; text-align: right; }
  .pentry__y { font-family: var(--font-display); font-weight: 700; font-size: 88px;
    line-height: 1; letter-spacing: -3.5px; font-variant-numeric: tabular-nums; }
  .pentry__k { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; }

  .pentry__card { grid-column: 2; grid-row: 1; display: flex; flex-direction: column; gap: 12px;
    padding: 40px 36px; background: #fff; border: 1px solid var(--line-l); border-radius: var(--radius); }
  .pentry__t { font-family: var(--font-display); font-weight: 500; font-size: 28px; letter-spacing: -1px; }
  .pentry__d { font-family: var(--font-body); font-size: 15px; line-height: 1.65; color: var(--dim-l); }
  .pentry__tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .pentry__tags span { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.5px;
    border: 1px solid var(--line-l); border-radius: var(--radius); padding: 6px 12px; color: var(--ink); }

  /* mirrored entry: card left (text hugging the spine), year right */
  .pentry--flip .pentry__year { grid-column: 2; align-items: flex-start; text-align: left; }
  .pentry--flip .pentry__card { grid-column: 1; text-align: right; }
  .pentry--flip .pentry__tags { justify-content: flex-end; }

  .pentry__node { position: absolute; left: 50%; top: 115px; transform: translateX(-50%);
    width: 12px; height: 12px; border-radius: 50%; background: var(--paper);
    border: 2px solid var(--accent-blue); z-index: 1; }
  .pentry.is-open .pentry__node { border-color: var(--accent); background: var(--accent); }
  .pentry__tick { position: absolute; left: calc(50% + 7px); top: 120px; width: 35px; height: 1px; background: var(--line-l); }
  .pentry--flip .pentry__tick { left: auto; right: calc(50% + 7px); }

  .pathdots { display: flex; gap: 8px; justify-content: center; margin-top: 40px; }
  .pathdot { width: 26px; height: 2px; background: var(--line-l); transition: background 0.3s ease, transform 0.3s ease; }
  .pathdot.is-active { background: var(--accent); transform: scaleY(2); }

  /* ── Pinned mode: section holds, entries swap ── */
  .pathpin.is-pinned { height: calc(var(--n) * 90vh); }
  .pathpin.is-pinned .pathpin__stage {
    position: sticky; top: 0; height: 100vh; display: flex; align-items: center; overflow: hidden;
  }
  .pathpin.is-pinned .pathpin__inner { width: 100%; }
  .pathpin.is-pinned .pathstage { margin-top: 56px; display: grid; }
  /* Discrete slides, not a continuous morph: entries sit in three states and CSS
     animates between them. Both directions move the same way, so scrolling down
     reads as a swipe up and scrolling up reads as a swipe down, automatically.
     Grid overlap (1/1) means the stage is as tall as the tallest entry — no
     fixed height, so it works at every breakpoint. */
  .pathpin.is-pinned .pentry {
    grid-area: 1 / 1; border-top: none; padding: 0;
    opacity: 0; transform: translateY(56px);
    transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.22, 0.9, 0.24, 1);
    will-change: transform, opacity; backface-visibility: hidden;
  }
  /* Outgoing leaves immediately; incoming waits a beat so you see it arrive. */
  .pathpin.is-pinned .pentry.is-active {
    opacity: 1; transform: translateY(0); transition-delay: 110ms;
  }
  .pathpin.is-pinned .pentry.is-past {
    opacity: 0; transform: translateY(-56px); transition-delay: 0ms;
  }
  .pathpin.is-pinned .pathdot { display: block; }
  .pathpin:not(.is-pinned) .pathdots { display: none; }

  /* ── Cursor card: trails the pointer on a spring (design z8JT6T) ──
     Sized to 90% of the design's 268x222. */
  .pcursor { position: fixed; left: 0; top: 0; z-index: 60; pointer-events: none; will-change: transform; }
  .pcursor__inner {
    width: 241px; border-radius: 3px; overflow: hidden; background: #0a0a0a;
    opacity: 0; transform: scale(0.3); transform-origin: 0 0;
    transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.22, 0.9, 0.24, 1);
  }
  .pcursor.is-on .pcursor__inner { opacity: 1; transform: scale(1); }
  .pcursor__photo { height: 167px; }
  .pcursor__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pcursor__foot {
    height: 32px; padding: 11px 13px; display: flex; align-items: center; justify-content: space-between;
    font-family: var(--font-mono); font-size: 8px; letter-spacing: 1px;
  }
  .pcursor__foot > span:first-child { color: var(--dim-d); }
  .pcursor__cta { color: var(--accent); }
  @media (hover: none), (pointer: coarse) { .pcursor { display: none; } }
  @media (prefers-reduced-motion: reduce) { .pcursor { display: none; } }

  /* ── Toolbox ── */
  /* Radar left (480), tools right at ~60% as a 3x5 grid — one axis per row. */
  .toolbox { padding: 160px 0; }
  .bench__sub { font-family: var(--font-body); font-size: 15px; line-height: 1.55; color: var(--dim-d); width: 400px; max-width: 100%; }
  .bench { display: grid; grid-template-columns: 480px 1fr; gap: 48px; align-items: start; margin-top: 8px; }
  .bench__radar { display: flex; flex-direction: column; gap: 24px; }
  .bench__radar svg { width: 100%; height: auto; }
  .bench__axis { font-family: var(--font-mono); font-size: 10px; fill: #fff; letter-spacing: 1px; cursor: pointer; transition: fill 0.2s ease; }
  .bench__axis.is-active, .bench__axis:hover { fill: var(--accent); }
  .bench__data { fill: rgba(255, 59, 48, 0.14); stroke: var(--accent); stroke-width: 2; }
  .bench__panel { background: var(--tile); border: 1px solid var(--accent); border-radius: var(--radius); padding: 16px 18px;
    display: flex; flex-direction: column; gap: 12px; }
  .bench__ph { display: flex; justify-content: space-between; align-items: center; }
  .bench__pl { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; }
  .bench__pv { font-family: var(--font-mono); font-size: 10px; color: #fff; }
  #benchList { display: flex; flex-direction: column; gap: 8px; }
  #benchList li { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  #benchList li span:first-child { font-family: var(--font-mono); font-size: 12px; color: #A8A8B3; }
  .bench__bar { display: inline-block; width: 76px; height: 3px; background: var(--line-d2); position: relative; flex: none; }
  .bench__bar i { position: absolute; left: 0; top: 0; height: 3px; background: var(--accent); }

  .axes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .tooltabs { display: none; }
  .tool { height: 148px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between;
    background: transparent; outline: 1px solid var(--line-d2); outline-offset: -0.5px; border-radius: var(--radius);
    transition: background 0.2s ease, outline-color 0.2s ease; }
  /* `display: flex` above outranks the UA stylesheet's [hidden] { display: none },
     so the mobile axis filter needs this explicitly. */
  .tool[hidden] { display: none; }
  .tool.is-active { background: rgba(255, 59, 48, 0.07); outline-color: var(--accent); }
  .tool__top { display: flex; justify-content: space-between; align-items: center; }
  .tool__n { font-family: var(--font-mono); font-size: 9px; color: var(--dim-d); transition: color 0.2s ease; }
  .tool.is-active .tool__n { color: var(--accent); }
  .tool__logo { width: 19px; height: 19px; fill: #fff; transition: fill 0.2s ease; }
  .tool.is-active .tool__logo { fill: var(--accent); }
  .tool__logo--none { display: block; }
  .tool__m { font-family: var(--font-display); font-weight: 700; font-size: 34px; line-height: 1; letter-spacing: -1.5px; color: #fff; transition: color 0.2s ease; }
  .tool.is-active .tool__m { color: var(--accent); }
  .tool__nm { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.5px; color: var(--dim-d); transition: color 0.2s ease; }
  .tool.is-active .tool__nm { color: #fff; }

  /* ── Life ── */
  .life__all { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1.5px; color: var(--accent); }
  .life__strip { margin: 24px 0; }
  .life__track { display: flex; animation-duration: 50s; }
  .life__track img { height: 260px; width: auto; object-fit: cover; }
  .life__ticker { border-top: 1px solid var(--line-l); padding: 16px 0; }
  .life__ttrack span { font-family: var(--font-mono); font-size: 12px; letter-spacing: 1px; color: var(--dim-l); white-space: nowrap; }

  /* ── Responsive ── */
  /* ── Hero below the fixed 1440 composition: becomes a flow layout ── */
  @media (max-width: 1100px) {
    .hero { height: auto; padding: 28px 0 40px; display: flex; flex-direction: column; gap: 26px; }
    .hero__vline { display: none; }
    .hero__marquees { position: static; }
    .hero__row { height: 56px; }
    .hero__track span { font-size: 32px; letter-spacing: -1px; }
    .hero__top { position: static; padding-inline: var(--pad); }
    .hero__portrait { position: relative; left: auto; top: auto; transform: none;
      margin-inline: auto; width: min(480px, calc(100% - 2 * var(--pad))); height: auto; aspect-ratio: 480 / 600; }
    .hero__bottom { position: static; align-items: flex-start; padding-inline: var(--pad); }
    .hero__title { font-size: 26px; line-height: 28px; }
    .hero__hud { font-size: 9px; }
  }

  @media (max-width: 560px) {
    .hero__title { font-size: 20px; line-height: 22px; }
    .hero__hud--bl { display: none; }
  }

  @media (max-width: 900px) {
    .sec { padding: 64px 0; }
    .who { padding: 64px var(--pad) 48px; }
    .what { padding: 48px var(--pad) 96px; }
    .who__top { flex-direction: column; align-items: flex-start; gap: 24px; }
    .who__statement { font-size: 34px; line-height: 1.08; letter-spacing: -1.4px; }
    .who__facts { grid-template-columns: repeat(2, 1fr); margin-top: 32px; }
    .who__body { grid-template-columns: 1fr; gap: 40px; margin-top: 48px; }
    .who__portrait { height: 260px; }
    .what__head { flex-direction: column; align-items: flex-start; gap: 16px; margin-bottom: 40px; }
    .what__title { font-size: 44px; letter-spacing: -1.6px; }
    .what__sub { width: 100%; }

    /* WhatGrid becomes a swipeable slider on mobile. Kept deliberately simple:
       no negative-margin edge bleed and proximity (not mandatory) snapping, both
       of which were fighting the initial position. */
    .what__grid {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 6px;
      touch-action: pan-x pan-y;
    }
    .what__grid::-webkit-scrollbar { display: none; }
    .cap { flex: 0 0 82%; scroll-snap-align: start; }

    .acc__head { grid-template-columns: 32px 1fr 40px; }
    .acc__tag, .acc__yr { display: none; }
    .acc__panel { grid-template-columns: 1fr; }
    .pathsec { padding: 64px 0; }
    .path__head { flex-direction: column; gap: 24px; }
    .path__hright { align-items: flex-start; width: 100%; }
    .pathstage { margin-top: 40px; gap: 16px; }
    .pentry { grid-template-columns: 1fr; gap: 16px; padding: 32px 0; }
    .pentry__year, .pentry--flip .pentry__year {
      grid-column: 1; grid-row: auto; align-items: flex-start; text-align: left; }
    .pentry__card, .pentry--flip .pentry__card {
      grid-column: 1; grid-row: auto; text-align: left; }
    .pentry--flip .pentry__tags { justify-content: flex-start; }
    .pentry__node, .pentry__tick { display: none; }
    .pentry__y { font-size: 56px; letter-spacing: -2px; }

    /* Pinned mode on mobile: compact enough to fit one viewport. */
    .pathpin.is-pinned .pathpin__stage { padding: 24px 0; }
    .pathpin.is-pinned .pathstage { margin-top: 28px; }
    .pathpin.is-pinned .pentry { gap: 12px; }
    .pathpin.is-pinned .pentry__y { font-size: 40px; letter-spacing: -1.6px; }
    .pathpin.is-pinned .pentry__card { padding: 22px 20px; gap: 10px; }
    .pathpin.is-pinned .pentry__t { font-size: 20px; letter-spacing: -0.6px; }
    .pathpin.is-pinned .pentry__d { font-size: 14px; line-height: 1.55; }
    .pathpin.is-pinned .pathdots { margin-top: 22px; }

    /* Toolbox on mobile: tabs, and only the active axis's tools. */
    .tooltabs { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 24px; }
    .tooltab {
      padding: 8px 12px; border: 1px solid var(--line-d2); border-radius: var(--radius);
      font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--dim-d);
      transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }
    .tooltab.is-active { background: var(--accent); border-color: var(--accent); color: #fff; }
    .axes { margin-top: 20px; }
    .toolbox { padding: 96px 0; }
    .bench { grid-template-columns: 1fr; gap: 40px; }
    .bench__radar { width: 100%; max-width: 480px; margin-inline: auto; }
    .axes { grid-template-columns: repeat(3, 1fr); }
    .proc__steps { grid-template-columns: repeat(2, 1fr); row-gap: 36px; }
    .proc__steps::before { display: none; }
    .life__track img { height: 180px; }
  }

  @media (max-width: 560px) {
    .toolbox { padding: 64px 0; }
    .axes { grid-template-columns: repeat(2, 1fr); }
    .proc__steps { grid-template-columns: 1fr; }
    .acc { padding: 0 20px; }
    .acc__panel { grid-template-columns: 1fr; gap: 24px; }
  }
</style>

<script define:vars={{ panelData }}>
  // Animated counters for WFacts. Keeps any prefix/suffix ("60+", "08").
  const counters = document.querySelectorAll('[data-count]');
  if (counters.length) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const run = (el) => {
      const raw = el.getAttribute('data-count') || el.textContent || '';
      const m = raw.match(/^(\D*)(\d+)(.*)$/);
      if (!m) return;
      const [, pre, digits, post] = m;
      const target = Number(digits);
      const width = digits.length;
      if (reduce) {
        el.textContent = pre + String(target).padStart(width, '0') + post;
        return;
      }
      const dur = 900;
      const t0 = performance.now();
      const step = (t) => {
        const p = Math.min(1, (t - t0) / dur);
        // ease-out cubic
        const e = 1 - Math.pow(1 - p, 3);
        const val = Math.round(target * e);
        el.textContent = pre + String(val).padStart(width, '0') + post;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            run(e.target);
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.5 }
    );
    counters.forEach((c) => io.observe(c));
  }

  // ── Path: pinned scroll. The section holds; entries cross-fade + slide. ──
  const pin = document.querySelector('[data-pin]');
  const pathStage = document.querySelector('[data-pathstage]');
  let pathActive = 0;
  if (pin && pathStage) {
    const entries = Array.from(pathStage.querySelectorAll('[data-pentry]'));
    const dots = Array.from(document.querySelectorAll('[data-pathdot]'));
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canPin = () => !reduceMotion && entries.length > 1;
    const clamp01 = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);

    let pinned = false;
    let current = 0;
    let pending = -1;
    let dwell = null;

    const paint = (idx) => {
      entries.forEach((el, i) => {
        el.classList.toggle('is-active', i === idx);
        el.classList.toggle('is-past', i < idx);
        el.style.pointerEvents = i === idx ? 'auto' : 'none';
      });
      dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
      pathActive = idx;
    };

    const setPinned = (on) => {
      if (on === pinned) return;
      pinned = on;
      pin.classList.toggle('is-pinned', on);
      clearTimeout(dwell);
      pending = -1;
      if (on) {
        current = 0;
        paint(0);
      } else {
        for (const el of entries) {
          el.classList.remove('is-active', 'is-past');
          el.style.pointerEvents = '';
        }
      }
    };

    const renderPath = () => {
      setPinned(canPin());
      if (!pinned) return;

      const rect = pin.getBoundingClientRect();
      const total = pin.offsetHeight - window.innerHeight;
      const p = total > 0 ? clamp01(-rect.top / total) : 0;

      // Stepped, not interpolated: each entry owns an equal slice of the scroll.
      const idx = Math.min(entries.length - 1, Math.floor(p * entries.length));
      if (idx === current) return;

      // Small dwell, so a fast flick lands on the right card without playing
      // every intermediate transition, but a slow scroll shows each one arrive.
      if (idx !== pending) {
        pending = idx;
        clearTimeout(dwell);
        dwell = setTimeout(() => {
          current = pending;
          paint(current);
        }, 130);
      }
    };

    let ticking = false;
    const onPathScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        renderPath();
        ticking = false;
      });
    };

    renderPath();
    window.addEventListener('scroll', onPathScroll, { passive: true });
    window.addEventListener('resize', onPathScroll);
  }

  // ── Path: cursor card that trails the pointer on a spring (design z8JT6T) ──
  const cursorEl = document.querySelector('[data-cursor]');
  if (
    cursorEl &&
    pathStage &&
    matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const cImg = cursorEl.querySelector('[data-cursor-img]');
    const cLabel = cursorEl.querySelector('[data-cursor-label]');
    const entries = Array.from(pathStage.querySelectorAll('[data-pentry]'));
    let tx = 0, ty = 0, x = 0, y = 0, vx = 0, vy = 0;
    let on = false;
    let running = false;

    const applyEntry = (el) => {
      if (!el) return;
      const src = el.getAttribute('data-img');
      const lbl = el.getAttribute('data-label');
      if (src && cImg && cImg.getAttribute('src') !== src) cImg.setAttribute('src', src);
      if (lbl && cLabel) cLabel.textContent = lbl;
    };

    const tick = () => {
      // Stiff, tightly-damped spring — minimal lag and almost no overshoot.
      vx = (vx + (tx - x) * 0.32) * 0.68;
      vy = (vy + (ty - y) * 0.32) * 0.68;
      x += vx;
      y += vy;
      cursorEl.style.transform = `translate3d(${(x + 18).toFixed(1)}px, ${(y + 18).toFixed(1)}px, 0)`;
      if (on || Math.abs(vx) > 0.1 || Math.abs(vy) > 0.1) {
        requestAnimationFrame(tick);
      } else {
        running = false;
      }
    };

    pathStage.addEventListener('pointermove', (e) => {
      tx = e.clientX;
      ty = e.clientY;
      if (!on) {
        on = true;
        x = tx;
        y = ty;
        vx = 0;
        vy = 0;
        cursorEl.classList.add('is-on');
        applyEntry(entries[pathActive] || entries[0]);
        if (!running) {
          running = true;
          requestAnimationFrame(tick);
        }
      }
      const hit = e.target && e.target.closest ? e.target.closest('[data-pentry]') : null;
      if (hit) applyEntry(hit);
    });

    pathStage.addEventListener('pointerleave', () => {
      on = false;
      cursorEl.classList.remove('is-on');
    });
  }

  // WhatIDo slider: mark whichever card is nearest the centre as active (mobile).
  // Drives the orange fill; on desktop the grid isn't a scroller so it clears.
  const capSlider = document.querySelector('[data-slider]');
  if (capSlider) {
    const caps = Array.from(capSlider.querySelectorAll('.cap'));
    let capRaf = 0;
    const markActiveCap = () => {
      capRaf = 0;
      if (window.innerWidth > 900 || capSlider.scrollWidth <= capSlider.clientWidth) {
        caps.forEach((c) => c.classList.remove('is-active'));
        return;
      }
      const box = capSlider.getBoundingClientRect();
      const mid = box.left + box.width / 2;
      let best = null;
      let bestDist = Infinity;
      for (const c of caps) {
        const r = c.getBoundingClientRect();
        const d = Math.abs(r.left + r.width / 2 - mid);
        if (d < bestDist) {
          bestDist = d;
          best = c;
        }
      }
      caps.forEach((c) => c.classList.toggle('is-active', c === best));
    };
    const onCapScroll = () => {
      if (!capRaf) capRaf = requestAnimationFrame(markActiveCap);
    };
    capSlider.addEventListener('scroll', onCapScroll, { passive: true });
    window.addEventListener('resize', onCapScroll);
    markActiveCap();
  }

  // Work accordion
  document.querySelectorAll('[data-acc] .acc__head').forEach((head) => {
    head.addEventListener('click', () => {
      const item = head.closest('[data-acc]');
      const open = item?.classList.contains('is-open');
      document.querySelectorAll('[data-acc]').forEach((a) => {
        a.classList.remove('is-open');
        a.querySelector('.acc__head')?.setAttribute('aria-expanded', 'false');
      });
      if (!open && item) {
        item.classList.add('is-open');
        head.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Toolbox: one active axis drives the panel, the radar labels, the tabs and the tools.
  const cols = document.querySelectorAll('[data-axis]');
  const bLabel = document.getElementById('benchLabel');
  const bPct = document.getElementById('benchPct');
  const bList = document.getElementById('benchList');
  const toolTabs = Array.from(document.querySelectorAll('[data-tooltab]'));
  const toolTiles = Array.from(document.querySelectorAll('.tool[data-axis]'));
  const isNarrow = () => window.innerWidth <= 900;

  let currentAxis = 0;

  // On mobile only the active axis's tools are shown — otherwise the section is
  // needlessly tall. On desktop all 15 stay, with the active row highlighted.
  const applyTools = (i) => {
    if (!isNarrow()) {
      toolTiles.forEach((t) => (t.hidden = false));
      return;
    }
    toolTiles.forEach((t) => {
      t.hidden = Number(t.getAttribute('data-axis')) !== i;
    });
  };

  const activateAxis = (i) => {
    const a = panelData[i];
    if (!a) return;
    currentAxis = i;

    cols.forEach((c) => c.classList.toggle('is-active', Number(c.getAttribute('data-axis')) === i));

    toolTabs.forEach((t) => {
      const on = Number(t.getAttribute('data-tooltab')) === i;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });

    if (bLabel) bLabel.textContent = a.label;
    if (bPct) bPct.textContent = a.v + '%';
    if (bList) bList.innerHTML = a.items.map((t) => `<li><span>${t}</span><span class="bench__bar"><i style="width:${a.v}%"></i></span></li>`).join('');

    applyTools(i);
  };

  // Radar labels drive it on hover and on tap.
  document.querySelectorAll('.bench__axis').forEach((el) => {
    const i = Number(el.getAttribute('data-axis'));
    el.addEventListener('mouseenter', () => activateAxis(i));
    el.addEventListener('click', () => activateAxis(i));
  });
  // Tabs drive it on tap (mobile).
  toolTabs.forEach((t) => {
    t.addEventListener('click', () => activateAxis(Number(t.getAttribute('data-tooltab'))));
  });
  // Hovering a tool lights its own axis too — by data-axis, not list index.
  toolTiles.forEach((t) => {
    t.addEventListener('mouseenter', () => activateAxis(Number(t.getAttribute('data-axis'))));
  });

  activateAxis(0);
  window.addEventListener('resize', () => activateAxis(currentAxis));
</script>
