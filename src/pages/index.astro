<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Amiruan — Creative Web Developer & AI Integration Specialist. Personal portfolio built with human-centered design, custom WordPress engineering, and thoughtful UX laws.">
  <meta name="theme-color" content="#FFFFFF">
  <title>Amiruan — Creative Developer & AI Specialist</title>
  <link rel="stylesheet" href="/assets/css/styles.css">
</head>
<body>

  <!-- Header / Navigation -->
  <header class="header" id="header" data-ux-law="Jakob's Law" data-ux-desc="Standard top navigation with familiar labels (Work, Stack, Architecture, Experience, Contact) so visitors know exactly where to find information.">
    <div class="container header__inner">
      <a href="#" class="brand" aria-label="Amiruan home">
        Amiruan<span class="brand__dot" aria-hidden="true"></span>
      </a>

      <nav class="nav" aria-label="Primary navigation">
        <a href="#about" class="nav__link">About</a>
        <a href="#projects" class="nav__link">Work</a>
        <a href="#stack" class="nav__link">Stack</a>
        <a href="#experience" class="nav__link">Experience</a>
        <a href="/gallery" class="nav__link">Gallery</a>
        <a href="#contact" class="nav__link">Contact</a>
      </nav>

      <div class="header__actions">
        <button class="header__tool ux-pathfinder__toggle" id="uxPathfinderToggle" aria-label="Open UX Pathfinder" aria-expanded="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <span>UX Pathfinder</span>
        </button>
        <button class="header__tool header__tool--coral" id="aiToggle" aria-label="Open AI command terminal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          <span>Ask AI</span>
          <kbd>⌘K</kbd>
        </button>
        <button class="mobile-toggle" id="mobileToggle" aria-label="Open menu" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <a href="#about" class="nav__link">About</a>
    <a href="#projects" class="nav__link">Work</a>
    <a href="#stack" class="nav__link">Stack</a>
    <a href="#experience" class="nav__link">Experience</a>
    <a href="/gallery" class="nav__link">Gallery</a>
    <a href="#contact" class="nav__link">Contact</a>
